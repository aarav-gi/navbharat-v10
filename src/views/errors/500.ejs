<%- include('../partials/header') %>

<main class="max-w-lg mx-auto px-4 py-24 flex-1 w-full text-center">
  <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-10 shadow-2xl">
    <div class="text-5xl mb-4">⚠️</div>
    <h1 class="text-xl font-bold text-white mb-2">Something went wrong</h1>
    <p class="text-sm text-slate-400 mb-6">An unexpected error occurred on our side. Please try again in a moment.</p>
    <a href="/" class="inline-block px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition">
      Go to Homepage
    </a>

    <% if (typeof debugError !== 'undefined' && debugError) { %>
      <div class="mt-8 text-left bg-black/40 border border-rose-500/30 rounded-xl p-4 overflow-x-auto">
        <p class="text-[10px] font-mono uppercase tracking-widest text-rose-400 mb-2">Dev-mode only — hidden in production</p>
        <p class="text-xs font-mono text-rose-300 mb-2"><%= debugError.message %></p>
        <pre class="text-[10px] font-mono text-slate-500 whitespace-pre-wrap"><%= debugError.stack %></pre>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

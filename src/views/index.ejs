  <style>
    /* 1. Global Touch & Tap Optimization */
    *, *::before, *::after {
      -webkit-tap-highlight-color: transparent !important;
    }
    button, a, .dock-btn, select, input {
      touch-action: manipulation;
    }

    /* 2. Kinetic 60fps Smooth Momentum Scroll */
    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }
    body {
      touch-action: pan-y;
      -webkit-font-smoothing: antialiased;
    }
    .overflow-y-auto {
      -webkit-overflow-scrolling: touch !important;
      overscroll-behavior-y: auto !important;
      scroll-behavior: smooth !important;
      touch-action: pan-y !important;
      transform: translateZ(0);
      will-change: scroll-position;
    }
    .scrollbar-thin {
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
    }

    /* 3. Tactile Physical Press States */
    .dock-btn, .master-card, .figma-glass, button, a {
      transition: transform 0.08s cubic-bezier(0, 0, 0.2, 1), filter 0.08s ease, box-shadow 0.08s ease !important;
      will-change: transform;
    }
    .touch-pressed {
      transform: scale(0.99) !important;
      filter: brightness(1.04) !important;
    }
    .dock-btn.touch-pressed {
      transform: scale(0.97) !important;
      background: rgba(99, 102, 241, 0.25) !important;
    }
    .dock-btn.active-dock {
      background: rgba(99, 102, 241, 0.25);
      border: 1px solid rgba(129, 140, 248, 0.45);
      color: #ffffff !important;
      font-weight: 700;
      box-shadow: 0 0 14px rgba(99, 102, 241, 0.4);
    }

    /* 4. Unified Dark Ad Theme Override */
    div[style*="background: white"], div[style*="background:#fff"], div[class*="bg-white"] {
      background: #0b1329 !important;
      color: #e2e8f0 !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }
  </style>


  <script>
    // Micro Haptic Feedback
    
  
  let selectedCategoryFilter = 'all';

  
  function handleSearchInput(input) {
    const clearBtn = document.getElementById("hubClearSearchBtn");
    if (clearBtn) clearBtn.classList.toggle("hidden", !input.value.trim());
    applyUnifiedDiscoveryFilter();
  }

  function clearHubSearch() {
    if (typeof triggerHaptic === 'function') triggerHaptic('light');
    const input = document.getElementById("hubSearchInput");
    if (input) {
      input.value = "";
      document.getElementById("hubClearSearchBtn").classList.add("hidden");
      applyUnifiedDiscoveryFilter();
    }
  }

  function resetAllHubFilters() {
    if (typeof triggerHaptic === 'function') triggerHaptic('medium');
    const input = document.getElementById("hubSearchInput");
    if (input) input.value = "";
    
    const clearBtn = document.getElementById("hubClearSearchBtn");
    if (clearBtn) clearBtn.classList.add("hidden");

    const stDropdown = document.getElementById("hubStateDropdown");
    if (stDropdown) stDropdown.value = "";

    const cmDropdown = document.getElementById("hubCommDropdown");
    if (cmDropdown) cmDropdown.value = "";

    const allBtn = document.querySelector(".univ-category-pill");
    if (allBtn) setUnifiedCategory('all', allBtn);
  }

  function setUnifiedCategory(cat, btn) {
    if (typeof triggerHaptic === 'function') triggerHaptic('light');
    selectedCategoryFilter = cat;
    
    document.querySelectorAll('.univ-category-pill').forEach(b => {
      b.className = 'univ-category-pill shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-medium transition-all duration-200 flex items-center gap-2 bg-white/[0.04] text-slate-300 border border-white/10 hover:bg-white/[0.08] hover:text-white';
    });
    btn.className = 'univ-category-pill active-pill shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-2 bg-indigo-600 text-white border border-indigo-400/40 shadow-[0_0_15px_rgba(99,102,241,0.35)]';
    
    applyUnifiedDiscoveryFilter();
  }

  function applyUnifiedDiscoveryFilter() {
    const sInput = document.getElementById('hubSearchInput');
    const searchVal = (sInput ? sInput.value : '').toLowerCase().trim();

    const stSelect = document.getElementById('hubStateDropdown');
    const selectedState = (stSelect ? stSelect.value : '').toLowerCase().trim();

    const cmSelect = document.getElementById('hubCommDropdown');
    const selectedComm = (cmSelect ? cmSelect.value : '').toLowerCase().trim();

    const cards = document.querySelectorAll('.master-card');

    cards.forEach(card => {
      const cardCat = (card.getAttribute('data-cat') || '').toLowerCase();
      const cardState = (card.getAttribute('data-state') || '').toLowerCase();
      const cardComm = (card.getAttribute('data-comm') || '').toLowerCase();
      const cardText = (card.innerText || '').toLowerCase();

      // Category check
      const matchCat = (selectedCategoryFilter === 'all') || (cardCat === selectedCategoryFilter);

      // State check
      let matchState = true;
      if (selectedState && selectedState !== 'all india') {
        matchState = cardState.includes(selectedState) || cardText.includes(selectedState);
      }

      // Commission check
      let matchComm = true;
      if (selectedComm) {
        matchComm = cardComm.includes(selectedComm) || cardText.includes(selectedComm);
      }

      // Search bar check
      let matchSearch = true;
      if (searchVal) {
        matchSearch = cardText.includes(searchVal) || cardComm.includes(searchVal) || cardState.includes(searchVal);
      }

      const isMatch = matchCat && matchState && matchComm && matchSearch;
      card.style.display = isMatch ? '' : 'none';
    });

    // Auto toggle empty recruitment boards
    const boards = ['board-jobs', 'board-results', 'board-admits', 'board-ak', 'board-syl'];
    boards.forEach(bId => {
      const bEl = document.getElementById(bId);
      if (bEl) {
        const bCards = bEl.querySelectorAll('.master-card');
        if (bCards.length > 0) {
          const hasVisible = Array.from(bCards).some(c => c.style.display !== 'none');
          bEl.style.display = hasVisible ? '' : 'none';
        }
      }
    });
  }

  function triggerHapticFeedback(type = "light") {
    try {
      if ("vibrate" in navigator) {
        navigator.vibrate(type === "light" ? 12 : 20);
      }
    } catch(e) {}
  }

  function selectCategoryFilter(cat, btn) {
    triggerHapticFeedback("light");
    currentActiveCategory = cat;
    
    document.querySelectorAll(".univ-cat-tab").forEach(tab => {
      tab.className = "univ-cat-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-medium transition-all duration-200 flex items-center gap-2 bg-white/[0.04] text-slate-300 border border-white/10 hover:bg-white/[0.08] hover:text-white";
    });

    btn.className = "univ-cat-tab active-cat-tab shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all duration-200 flex items-center gap-2 bg-indigo-600 text-white border border-indigo-400/40 shadow-[0_0_15px_rgba(99,102,241,0.35)]";
    
    executeUniversalFilter();
  }

  function clearUniversalSearch() {
    triggerHapticFeedback("light");
    const input = document.getElementById("universalSearchInput");
    if (input) {
      input.value = "";
      document.getElementById("searchClearBtn").classList.add("hidden");
      executeUniversalFilter();
    }
  }

  function resetUniversalFilter() {
    triggerHapticFeedback("medium");
    const searchInput = document.getElementById("universalSearchInput");
    if (searchInput) searchInput.value = "";
    
    const stateSelect = document.getElementById("univStateSelect");
    if (stateSelect) stateSelect.value = "";
    
    const commSelect = document.getElementById("univCommSelect");
    if (commSelect) commSelect.value = "";
    
    const allBtn = document.querySelector(".univ-cat-tab");
    if (allBtn) selectCategoryFilter('all', allBtn);
  }

  function executeUniversalFilter() {
    const searchInput = document.getElementById("universalSearchInput");
    const searchVal = (searchInput ? searchInput.value : "").trim().toLowerCase();
    
    const clearBtn = document.getElementById("searchClearBtn");
    if (clearBtn) clearBtn.classList.toggle("hidden", searchVal.length === 0);

    const stateSelect = document.getElementById("univStateSelect");
    const selectedState = stateSelect ? stateSelect.value.trim().toLowerCase() : "";

    const commSelect = document.getElementById("univCommSelect");
    const selectedComm = commSelect ? commSelect.value.trim().toLowerCase() : "";

    const cards = document.querySelectorAll(".master-card, [data-cat]");
    let visibleCount = 0;
    const isFiltered = searchVal.length > 0 || selectedState.length > 0 || selectedComm.length > 0 || currentActiveCategory !== 'all';

    cards.forEach(card => {
      const cardCat = (card.getAttribute("data-cat") || "").toLowerCase();
      const cardState = (card.getAttribute("data-state") || "").toLowerCase();
      const cardComm = (card.getAttribute("data-comm") || "").toLowerCase();
      const text = (card.innerText || "").toLowerCase();

      // Category match
      const matchCat = (currentActiveCategory === 'all') || (cardCat === currentActiveCategory);

      // State match
      const matchState = !selectedState || cardState.includes(selectedState) || (selectedState === 'all india');

      // Commission match
      const matchComm = !selectedComm || cardComm.includes(selectedComm);

      // Search text match
      const matchSearch = !searchVal || text.includes(searchVal) || cardComm.includes(searchVal) || cardState.includes(searchVal);

      const isMatch = matchCat && matchState && matchComm && matchSearch;
      card.style.display = isMatch ? "" : "none";
      if (isMatch) visibleCount++;
    });

    // Update feedback bar
    const feedbackBar = document.getElementById("univFeedbackBar");
    const matchCountEl = document.getElementById("univMatchCount");
    if (feedbackBar && matchCountEl) {
      feedbackBar.classList.toggle("hidden", !isFiltered);
      matchCountEl.textContent = visibleCount;
    }

    // Check board visibility (hide board if empty during filter)
    const boards = ["board-jobs", "board-results", "board-admits", "board-ak", "board-syl"];
    boards.forEach(boardId => {
      const boardEl = document.getElementById(boardId);
      if (boardEl) {
        const boardCards = boardEl.querySelectorAll(".master-card, [data-cat]");
        if (boardCards.length > 0) {
          const hasVisible = Array.from(boardCards).some(c => c.style.display !== "none");
          boardEl.style.display = hasVisible ? "" : "none";
        }
      }
    });
  }

  function triggerHaptic(type = "light") {
      try {
        if ("vibrate" in navigator) {
          navigator.vibrate(type === "light" ? 12 : [16, 25, 16]);
        }
      } catch (e) {}
    }

    // Hardware-Accelerated Smooth Jump
    function jumpToBoard(id) {
      triggerHaptic("medium");
      const el = document.getElementById(id);
      if (el) {
        const header = document.querySelector("header");
        const headerH = header ? header.offsetHeight : 64;
        const targetY = el.getBoundingClientRect().top + window.pageYOffset - headerH - 14;
        window.scrollTo({
          top: targetY,
          behavior: "smooth"
        });
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      // 1. Instant Physical Tap Listeners
      const interactiveSelector = ".dock-btn, .figma-glass, button, .rounded-2xl";
      document.body.addEventListener("touchstart", (e) => {
        const target = e.target.closest(interactiveSelector);
        if (target) {
          target.classList.add("touch-pressed");
          triggerHaptic("light");
        }
      }, { passive: true });

      const removePress = (e) => {
        const target = e.target.closest(interactiveSelector);
        if (target) {
          setTimeout(() => target.classList.remove("touch-pressed"), 100);
        } else {
          document.querySelectorAll(".touch-pressed").forEach(el => el.classList.remove("touch-pressed"));
        }
      };
      document.body.addEventListener("touchend", removePress, { passive: true });
      document.body.addEventListener("touchcancel", removePress, { passive: true });

      // 2. Active Dock Indicator (Intersection Observer)
      const boardIds = ["board-jobs", "board-admit", "board-results"];
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            document.querySelectorAll(".dock-btn").forEach(b => b.classList.remove("active-dock"));
            const activeBtn = document.getElementById("dock-" + entry.target.id);
            if (activeBtn) activeBtn.classList.add("active-dock");
          }
        });
      }, { rootMargin: "-20% 0px -60% 0px", threshold: 0.1 });

      boardIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    });
  </script>


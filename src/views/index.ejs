<%- include('partials/header') %>

<% if (typeof itemListJsonLd !== 'undefined' && itemListJsonLd) { %>
  <script type="application/ld+json">
    <%- itemListJsonLd %>
  </script>
<% } %>

<%
  // High-performance word boundary matching
  function hasWord(text, word) {
    if (!text || !word) return false;
    return new RegExp('(?:^|[^a-zA-Z0-9])' + word.toLowerCase().trim() + '(?:[^a-zA-Z0-9]|$)', 'i').test(text);
  }

  function getState(org) {
    const o = (org || '').toLowerCase();

    // 8 Union Territories
    if (hasWord(o, 'delhi') || hasWord(o, 'dsssb')) return 'Delhi';
    if (hasWord(o, 'jammu') || hasWord(o, 'kashmir') || hasWord(o, 'jkssb') || hasWord(o, 'jkpsc')) return 'Jammu & Kashmir';
    if (hasWord(o, 'ladakh')) return 'Ladakh';
    if (hasWord(o, 'chandigarh')) return 'Chandigarh';
    if (hasWord(o, 'puducherry') || hasWord(o, 'pondicherry')) return 'Puducherry';
    if (hasWord(o, 'andaman')) return 'Andaman & Nicobar';
    if (hasWord(o, 'lakshadweep')) return 'Lakshadweep';
    if (hasWord(o, 'dadra') || hasWord(o, 'daman') || hasWord(o, 'diu')) return 'Dadra & Daman';

    // 28 States
    if (hasWord(o, 'uttar pradesh') || hasWord(o, 'uppsc') || hasWord(o, 'upsssc') || hasWord(o, 'up') || hasWord(o, 'uptet')) return 'Uttar Pradesh';
    if (hasWord(o, 'bihar') || hasWord(o, 'bpsc') || hasWord(o, 'bssc') || hasWord(o, 'btsc') || hasWord(o, 'stet')) return 'Bihar';
    if (hasWord(o, 'rajasthan') || hasWord(o, 'rpsc') || hasWord(o, 'rsmssb') || hasWord(o, 'rssb') || hasWord(o, 'reet')) return 'Rajasthan';
    if (hasWord(o, 'madhya pradesh') || hasWord(o, 'mppsc') || hasWord(o, 'mp') || hasWord(o, 'mpesb') || hasWord(o, 'mptet')) return 'Madhya Pradesh';
    if (hasWord(o, 'uttarakhand') || hasWord(o, 'ukpsc') || hasWord(o, 'uksssc') || hasWord(o, 'utet') || hasWord(o, 'uk') || hasWord(o, 'ubse')) return 'Uttarakhand';
    if (hasWord(o, 'haryana') || hasWord(o, 'hssc') || hasWord(o, 'hpsc') || hasWord(o, 'htet')) return 'Haryana';
    if (hasWord(o, 'punjab') || hasWord(o, 'ppsc') || hasWord(o, 'psssb') || hasWord(o, 'pstet')) return 'Punjab';
    if (hasWord(o, 'himachal') || hasWord(o, 'hppsc') || hasWord(o, 'hptet') || hasWord(o, 'hp')) return 'Himachal Pradesh';
    if (hasWord(o, 'jharkhand') || hasWord(o, 'jpsc') || hasWord(o, 'jssc') || hasWord(o, 'jtet')) return 'Jharkhand';
    if (hasWord(o, 'chhattisgarh') || hasWord(o, 'cgpsc') || hasWord(o, 'cgvyapam') || hasWord(o, 'cgtet')) return 'Chhattisgarh';
    if (hasWord(o, 'gujarat') || hasWord(o, 'gpsc') || hasWord(o, 'gsssb')) return 'Gujarat';
    if (hasWord(o, 'maharashtra') || hasWord(o, 'mpsc') || hasWord(o, 'maha')) return 'Maharashtra';
    if (hasWord(o, 'west bengal') || hasWord(o, 'bengal') || hasWord(o, 'wbpsc') || hasWord(o, 'wbssc') || hasWord(o, 'wbtet')) return 'West Bengal';
    if (hasWord(o, 'odisha') || hasWord(o, 'orissa') || hasWord(o, 'opsc') || hasWord(o, 'ossc') || hasWord(o, 'otet')) return 'Odisha';
    if (hasWord(o, 'assam') || hasWord(o, 'apsc') || hasWord(o, 'atet')) return 'Assam';
    if (hasWord(o, 'andhra') || hasWord(o, 'appsc') || hasWord(o, 'aptet')) return 'Andhra Pradesh';
    if (hasWord(o, 'telangana') || hasWord(o, 'tspsc') || hasWord(o, 'tgtet')) return 'Telangana';
    if (hasWord(o, 'tamil nadu') || hasWord(o, 'tamil') || hasWord(o, 'tnpsc') || hasWord(o, 'tntet') || hasWord(o, 'trb')) return 'Tamil Nadu';
    if (hasWord(o, 'karnataka') || hasWord(o, 'kpsc') || hasWord(o, 'kea') || hasWord(o, 'kartet')) return 'Karnataka';
    if (hasWord(o, 'kerala') || hasWord(o, 'kpsc') || hasWord(o, 'ktet')) return 'Kerala';
    if (hasWord(o, 'goa') || hasWord(o, 'gpsc')) return 'Goa';
    if (hasWord(o, 'sikkim') || hasWord(o, 'spsc')) return 'Sikkim';
    if (hasWord(o, 'tripura') || hasWord(o, 'tpsc')) return 'Tripura';
    if (hasWord(o, 'meghalaya')) return 'Meghalaya';
    if (hasWord(o, 'manipur')) return 'Manipur';
    if (hasWord(o, 'mizoram')) return 'Mizoram';
    if (hasWord(o, 'nagaland') || hasWord(o, 'npsc')) return 'Nagaland';
    if (hasWord(o, 'arunachal') || hasWord(o, 'appsc')) return 'Arunachal Pradesh';

    return 'All India';
  }

  function getCommission(org) {
    const o = (org || '').toLowerCase();

    // Teaching & Entrance Commissions (Explicit matching)
    if (hasWord(o, 'nta') || hasWord(o, 'neet') || hasWord(o, 'jee') || hasWord(o, 'cuet') || hasWord(o, 'ugc') || hasWord(o, 'csir')) return 'NTA';
    if (hasWord(o, 'ctet') || hasWord(o, 'cbse')) return 'CTET / CBSE';
    if (hasWord(o, 'utet') || hasWord(o, 'ubse') || hasWord(o, 'uk board')) return 'UTET (Uttarakhand)';
    if (hasWord(o, 'uptet')) return 'UPTET (Uttar Pradesh)';
    if (hasWord(o, 'reet')) return 'REET (Rajasthan)';
    if (hasWord(o, 'kvs') || hasWord(o, 'nvs') || hasWord(o, 'emrs') || hasWord(o, 'dsssb')) return 'DSSSB / National Teaching';
    if (hasWord(o, 'tet') || hasWord(o, 'teacher') || hasWord(o, 'trb')) return 'Teaching Recruitment';

    // Central Recruitment Boards
    if (hasWord(o, 'upsc')) return 'UPSC';
    if (hasWord(o, 'ssc') || hasWord(o, 'cgl') || hasWord(o, 'chsl') || hasWord(o, 'mts') || hasWord(o, 'gd')) return 'SSC';
    if (hasWord(o, 'rrb') || hasWord(o, 'rrc') || hasWord(o, 'railway') || hasWord(o, 'alp')) return 'Railway (RRB)';
    if (hasWord(o, 'bank') || hasWord(o, 'ibps') || hasWord(o, 'sbi') || hasWord(o, 'rbi') || hasWord(o, 'nabard')) return 'Banking';
    if (hasWord(o, 'defence') || hasWord(o, 'army') || hasWord(o, 'navy') || hasWord(o, 'air force') || hasWord(o, 'nda') || hasWord(o, 'cds')) return 'Defence';
    if (hasWord(o, 'police') || hasWord(o, 'crpf') || hasWord(o, 'bsf') || hasWord(o, 'cisf') || hasWord(o, 'itbp') || hasWord(o, 'ssb')) return 'Police & Paramilitary';
    if (hasWord(o, 'court') || hasWord(o, 'judiciary') || hasWord(o, 'high court')) return 'Judiciary';

    // State Commissions (North, Central, West, East, South)
    if (hasWord(o, 'uppsc')) return 'UPPSC (Uttar Pradesh)';
    if (hasWord(o, 'upsssc')) return 'UPSSSC (Uttar Pradesh)';
    if (hasWord(o, 'bpsc')) return 'BPSC (Bihar)';
    if (hasWord(o, 'bssc') || hasWord(o, 'btsc')) return 'BSSC (Bihar)';
    if (hasWord(o, 'ukpsc')) return 'UKPSC (Uttarakhand)';
    if (hasWord(o, 'uksssc')) return 'UKSSSC (Uttarakhand)';
    if (hasWord(o, 'rpsc') || hasWord(o, 'rsmssb') || hasWord(o, 'rssb')) return 'RPSC / RSMSSB (Rajasthan)';
    if (hasWord(o, 'mppsc') || hasWord(o, 'mpesb') || hasWord(o, 'esb')) return 'MPPSC / ESB (Madhya Pradesh)';
    if (hasWord(o, 'hssc') || hasWord(o, 'hpsc')) return 'HSSC / HPSC (Haryana)';
    if (hasWord(o, 'jpsc') || hasWord(o, 'jssc')) return 'JPSC / JSSC (Jharkhand)';
    if (hasWord(o, 'cgpsc') || hasWord(o, 'cgvyapam')) return 'CGPSC (Chhattisgarh)';
    if (hasWord(o, 'wbpsc') || hasWord(o, 'wbssc')) return 'WBPSC (West Bengal)';
    if (hasWord(o, 'gpsc') || hasWord(o, 'gsssb')) return 'GPSC (Gujarat)';
    if (hasWord(o, 'mpsc') || hasWord(o, 'maha')) return 'MPSC (Maharashtra)';
    if (hasWord(o, 'ppsc') || hasWord(o, 'psssb')) return 'PPSC / PSSSB (Punjab)';
    if (hasWord(o, 'hppsc') || hasWord(o, 'hpsssb')) return 'HPPSC (Himachal Pradesh)';
    if (hasWord(o, 'opsc') || hasWord(o, 'ossc')) return 'OPSC / OSSC (Odisha)';
    if (hasWord(o, 'apsc')) return 'APSC (Assam)';
    if (hasWord(o, 'appsc')) return 'APPSC (Andhra Pradesh)';
    if (hasWord(o, 'tspsc')) return 'TSPSC (Telangana)';
    if (hasWord(o, 'tnpsc')) return 'TNPSC (Tamil Nadu)';
    if (hasWord(o, 'kpsc') || hasWord(o, 'kea')) return 'KPSC (Karnataka)';
    if (hasWord(o, 'kerala') || hasWord(o, 'kpsc')) return 'Kerala PSC';
    if (hasWord(o, 'jkssb') || hasWord(o, 'jkpsc')) return 'JKSSB / JKPSC (J&K)';

    return 'Other Board / Commission';
  }

  
  const officialStatesAndUTs = [
    // 28 States
    'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chhattisgarh',
    'Goa', 'Gujarat', 'Haryana', 'Himachal Pradesh', 'Jharkhand',
    'Karnataka', 'Kerala', 'Madhya Pradesh', 'Maharashtra', 'Manipur',
    'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Punjab',
    'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura',
    'Uttar Pradesh', 'Uttarakhand', 'West Bengal',
    // 8 Union Territories
    'Andaman & Nicobar', 'Chandigarh', 'Dadra & Daman', 'Delhi',
    'Jammu & Kashmir', 'Ladakh', 'Lakshadweep', 'Puducherry'
  ];

  const allPostsList = (typeof posts !== 'undefined' && Array.isArray(posts)) ? posts : [];

  const dynamicStates = Array.from(new Set(
    allPostsList.map(p => (typeof getState === 'function') ? getState(p.organization) : 'All India').filter(Boolean)
  )).sort();

  
  const officialCommissionsList = [
    // Teaching & Entrance
    'NTA', 'CTET / CBSE', 'UTET (Uttarakhand)', 'UPTET (Uttar Pradesh)', 'REET (Rajasthan)', 'DSSSB / National Teaching', 'Teaching Recruitment',
    // Central Recruitment
    'UPSC', 'SSC', 'Railway (RRB)', 'Banking', 'Defence', 'Police & Paramilitary', 'Judiciary',
    // State Commissions
    'UPPSC (Uttar Pradesh)', 'UPSSSC (Uttar Pradesh)', 'BPSC (Bihar)', 'BSSC (Bihar)',
    'UKPSC (Uttarakhand)', 'UKSSSC (Uttarakhand)', 'RPSC / RSMSSB (Rajasthan)',
    'MPPSC / ESB (Madhya Pradesh)', 'HSSC / HPSC (Haryana)', 'JPSC / JSSC (Jharkhand)',
    'CGPSC (Chhattisgarh)', 'WBPSC (West Bengal)', 'GPSC (Gujarat)', 'MPSC (Maharashtra)',
    'PPSC / PSSSB (Punjab)', 'HPPSC (Himachal Pradesh)', 'OPSC / OSSC (Odisha)',
    'APSC (Assam)', 'APPSC (Andhra Pradesh)', 'TSPSC (Telangana)', 'TNPSC (Tamil Nadu)',
    'KPSC (Karnataka)', 'Kerala PSC', 'JKSSB / JKPSC (J&K)'
  ];

  const dynamicComms = Array.from(new Set(
    allPostsList.map(p => (typeof getCommission === 'function') ? getCommission(p.organization) : 'Other').filter(Boolean)
  )).sort();

  const dynamicCounts = {
    all: allPostsList.length,
    jobs: allPostsList.filter(p => p.category === 'latest-jobs').length,
    admits: allPostsList.filter(p => p.category === 'admit-card').length,
    results: allPostsList.filter(p => p.category === 'results').length,
    ak: allPostsList.filter(p => p.category === 'answer-key').length,
    syl: allPostsList.filter(p => p.category === 'syllabus').length
  };
%>


<style>
  html, body {
    max-width: 100% !important;
    overflow-x: clip !important;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  /* Desktop Card Hover Elevation */
  @media (min-width: 768px) {
    .master-card {
      transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .master-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.6), 0 0 15px 1px rgba(99, 102, 241, 0.15);
    }
  }
</style>

<main class="max-w-6xl mx-auto px-4 py-6 flex-1 w-full pb-20">

  <!-- Hero Section -->
  <div class="text-center pt-8 pb-4 md:pt-14 md:pb-6 max-w-4xl mx-auto relative px-2">

    <!-- Top Verified Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full figma-pill text-xs font-semibold text-slate-300 mb-5 shadow-sm">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="tracking-wide text-emerald-300 font-medium">100% Verified Sarkari Feeds</span>
      <span class="text-slate-600">•</span>
      <span class="text-indigo-400 font-medium">रोज़ाना नया अपडेट</span>
    </div>

    <!-- Power Headline -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.14]">
      Sarkari Career Discovery &amp;<br class="hidden sm:inline" />
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-sky-300 to-emerald-400">Recruitment Intelligence Hub</span>
    </h1>

    <p class="text-slate-300 text-xs sm:text-sm md:text-base mt-3.5 max-w-2xl mx-auto leading-relaxed">
      Sabhi Central &amp; State recruitment commissions ke direct official portal links, syllabus PDFs aur dates — ek hi click me verified.
    </p>

    <!-- High-Trust Discovery Pillars -->
    <div class="grid grid-cols-3 gap-2 sm:gap-4 max-w-3xl mx-auto mt-6 text-left">
      <div class="figma-glass p-3.5 rounded-2xl relative overflow-hidden block">
        <div class="flex items-center justify-between">
          <span class="text-2xl font-black text-indigo-400 font-mono"><%= dynamicCounts.jobs %>+</span>
          <span class="text-[10px] bg-indigo-500/10 text-indigo-300 px-1.5 py-0.5 rounded border border-indigo-500/20 font-semibold uppercase">Active</span>
        </div>
        <div class="text-[12px] font-bold text-white mt-1.5">Live Openings</div>
        <div class="text-[10px] text-slate-400">Apply link enabled</div>
      </div>

      <div class="figma-glass p-3.5 rounded-2xl relative overflow-hidden block">
        <div class="flex items-center justify-between">
          <span class="text-2xl font-black text-emerald-400 font-mono">100%</span>
          <span class="text-[10px] bg-emerald-500/10 text-emerald-300 px-1.5 py-0.5 rounded border border-emerald-500/20 font-semibold uppercase">Direct</span>
        </div>
        <div class="text-[12px] font-bold text-white mt-1.5">Official Links</div>
        <div class="text-[10px] text-slate-400">Zero fake redirects</div>
      </div>

      <div class="figma-glass p-3.5 rounded-2xl relative overflow-hidden block">
        <div class="flex items-center justify-between">
          <span class="text-2xl font-black text-cyan-400 font-mono">36</span>
          <span class="text-[10px] bg-cyan-500/10 text-cyan-300 px-1.5 py-0.5 rounded border border-cyan-500/20 font-semibold uppercase">Coverage</span>
        </div>
        <div class="text-[12px] font-bold text-white mt-1.5">States &amp; UTs</div>
        <div class="text-[10px] text-slate-400">All India + State Boards</div>
      </div>
    </div>

    <!-- FIGMA FROSTED GLASS UNIVERSAL DISCOVERY HUB (ALL SCREENS OPTIMIZED) -->
    <div id="discovery-hub" class="mt-8 mb-6 mx-auto w-full max-w-5xl text-left overflow-hidden">
      <div class="p-4 sm:p-6 lg:p-7 rounded-3xl bg-[#0b132b]/85 border border-white/10 backdrop-blur-2xl shadow-[0_12px_45px_rgba(0,0,0,0.55)] relative overflow-hidden transition-all duration-300">
        
        <!-- Ambient Indigo Backlight Glow (Expands smoothly on desktop) -->
        <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-80 md:w-[600px] h-28 bg-indigo-500/15 blur-3xl pointer-events-none rounded-full"></div>

        <!-- Row 1: Search Bar with Active Clear Button -->
        <div class="relative w-full mb-3.5 group">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-indigo-400 group-focus-within:text-indigo-300 transition-colors">
            <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <input type="text" 
                 id="hubSearchInput" 
                 oninput="handleSearchInput(this)"
                 placeholder="Search e.g. SSC CGL, BPSC, Police, 10th Pass, UTET..." 
                 class="w-full pl-10 pr-10 py-2.5 sm:py-3 rounded-2xl bg-white/[0.03] border border-white/10 text-white placeholder-slate-400/80 text-xs sm:text-sm focus:outline-none focus:border-indigo-500/70 focus:bg-white/[0.06] focus:ring-4 focus:ring-indigo-500/15 transition-all shadow-inner">
          <button type="button" 
                  id="hubClearSearchBtn" 
                  onclick="clearHubSearch()" 
                  class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-white transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Row 3: Dropdowns (Tablet & Desktop: Perfectly balanced 2-column grid with custom styling) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-4 pt-4 border-t border-white/[0.08]">
          <div>
            <label class="block text-[11px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mb-1.5 flex items-center gap-1.5">
              <span>📍 State / Region</span>
              <span class="text-[10px] text-indigo-400/80">(Pan-India)</span>
            </label>
            <div class="relative">
              <select id="hubStateDropdown" onchange="applyUnifiedDiscoveryFilter()"
                      class="w-full bg-[#080d1a] border border-white/10 rounded-xl px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm font-medium text-slate-200 focus:outline-none focus:border-indigo-500/60 focus:ring-2 focus:ring-indigo-500/20 appearance-none pr-9 transition-colors cursor-pointer">
                <option value="">All States & UTs (Pan-India)</option>
                <% officialStatesAndUTs.forEach(function(st) { %>
                  <option value="<%= st %>"><%= st %></option>
                <% }); %>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-[11px] sm:text-xs font-mono uppercase tracking-wider text-slate-400 mb-1.5 flex items-center gap-1.5">
              <span>🏛️ Board / Commission</span>
              <span class="text-[10px] text-cyan-400/80">(National & State)</span>
            </label>
            <div class="relative">
              <select id="hubCommDropdown" onchange="applyUnifiedDiscoveryFilter()"
                      class="w-full bg-[#080d1a] border border-white/10 rounded-xl px-3.5 py-2.5 sm:py-3 text-xs sm:text-sm font-medium text-slate-200 focus:outline-none focus:border-indigo-500/60 focus:ring-2 focus:ring-indigo-500/20 appearance-none pr-9 transition-colors cursor-pointer">
                <option value="">All Boards & Commissions (NTA, CTET, UTET, State)</option>
                <% officialCommissionsList.forEach(function(cm) { %>
                  <option value="<%= cm %>"><%= cm %></option>
                <% }); %>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div> <!-- Close Hero Section -->

  <!-- Top Sponsored Billboard Ad Slot -->
  <%- include('partials/ad-slot', { slotType: 'top' }) %>


  <% if (typeof trending !== 'undefined' && trending && trending.length > 0) { %>
  <section id="trending-section" class="mb-5">
    <div class="flex items-center gap-3.5 mb-2 border-b border-white/10 pb-1.5">
      <span class="text-xs">🔥</span>
      <h2 class="text-xs sm:text-sm font-black text-amber-400 uppercase tracking-wider">Trending Now</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
      <% trending.forEach(item => { %>
        <a href="/<%= item.category %>/<%= item.slug %>"
           class="group flex flex-col justify-center px-2.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-500/[0.07] to-[#0F172A] hover:bg-[#181424] border border-amber-500/30 hover:border-amber-400/60 transition-all duration-100 shadow-sm">
          
          <div class="flex items-center justify-between gap-3.5 leading-tight">
            <h3 class="text-xs font-bold text-slate-100 group-hover:text-amber-300 transition-colors truncate flex items-center gap-1">
              <span class="text-amber-400 text-[10px]">🔥</span>
              <span><%= item.title %></span>
            </h3>
            <span class="inline-flex items-center font-mono text-[9px] font-bold text-rose-400 bg-rose-500/10 px-1 py-0.5 rounded shrink-0">
              <%= item.applicationEnd || 'Active' %>
            </span>
          </div>

          <div class="flex items-center justify-between gap-1 mt-1 text-[9.5px] leading-none">
            <span class="text-slate-400 truncate opacity-85">
              <%= item.organization %>
            </span>
            <span class="text-amber-400 font-semibold uppercase text-[9px] bg-amber-500/10 px-1 py-0.5 rounded shrink-0">
              <%= item.category %>
            </span>
          </div>

        </a>
      <% }) %>
    </div>
  </section>
  <% } %>


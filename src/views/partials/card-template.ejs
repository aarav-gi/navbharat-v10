<%
  let cardState = 'All India';
  let cardComm = 'Govt';
  try {
    if (typeof getState === 'function') cardState = getState(item.organization);
    if (typeof getCommission === 'function') cardComm = getCommission(item.organization);
  } catch (e) {}
%>
<a href="/<%= item.category %>/<%= item.slug %>"
   class="master-card figma-card group block px-3 py-2 rounded-lg text-decoration-none relative overflow-hidden transition-all duration-150 hover:border-indigo-500/40 shrink-0"
   data-state="<%= cardState %>"
   data-cat="<%= item.category %>"
   data-comm="<%= cardComm %>">

  <!-- Row 1: Title (Strict Truncation, 100% Width) -->
  <div class="w-full overflow-hidden mb-1">
    <h3 class="text-xs font-semibold text-slate-100 group-hover:text-indigo-300 truncate leading-snug">
      <%= item.title %>
    </h3>
  </div>

  <!-- Row 2: Metadata Badges + Right Action (Clean Separated Row) -->
  <div class="flex items-center justify-between gap-2 text-[10px] pt-1 border-t border-white/[0.04]">
    <div class="flex items-center gap-1.5 min-w-0 overflow-hidden text-slate-400">
      <span class="text-slate-300 font-medium truncate max-w-[90px] bg-white/[0.04] px-1.5 py-0.2 rounded border border-white/[0.06]">
        <%= cardState === 'All India' ? '🇮🇳 All India' : cardState %>
      </span>
      <% if (cardComm) { %>
        <span class="font-mono text-cyan-400/90 truncate max-w-[110px]">
          <%= cardComm %>
        </span>
      <% } %>
    </div>

    <div class="shrink-0 flex items-center gap-1.5">
      <% if (item.category === 'latest-jobs') { %>
        <span class="inline-flex items-center font-mono text-[9px] font-semibold text-rose-300 bg-rose-500/10 px-1.5 py-0.2 rounded border border-rose-500/20">
          ⏳ <%= item.applicationEnd || 'Open' %>
        </span>
      <% } else if (item.category === 'admit-card') { %>
        <span class="inline-flex items-center font-mono text-[9px] font-semibold text-amber-300 bg-amber-500/10 px-1.5 py-0.2 rounded border border-amber-500/20">
          Exam Out
        </span>
      <% } else if (item.category === 'results') { %>
        <span class="inline-flex items-center text-[9px] font-semibold text-indigo-300 bg-indigo-500/10 px-1.5 py-0.2 rounded border border-indigo-500/20">
          🏆 Declared
        </span>
      <% } else { %>
        <span class="inline-flex items-center text-[9px] font-semibold text-sky-300 bg-sky-500/10 px-1.5 py-0.2 rounded border border-sky-500/20">
          📚 PDF
        </span>
      <% } %>

      <button type="button"
              onclick="handleCardShare(event, this)"
              data-title="<%= item.title %>"
              data-category="<%= item.category %>"
              data-slug="<%= item.slug %>"
              data-org="<%= item.organization || '' %>"
              class="w-4.5 h-4.5 rounded bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 flex items-center justify-center transition-colors"
              title="Share on WhatsApp">
        <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
      </svg>
      </button>
    </div>
  </div>
</a>

<!-- Behavioral Honeypot Node -->
<a href="/system/crawler-trap-node" rel="nofollow" aria-hidden="true" tabindex="-1" style="display:none!important;position:absolute!important;left:-9999px!important;top:-9999px!important;visibility:hidden!important;">Site Crawl Directory</a>
<script>
  (function() {
    // Native Vibrate Executor
    window.triggerHaptic = function(type) {
      if (!navigator || typeof navigator.vibrate !== "function") return;
      try {
        if (type === "action" || type === "heavy") {
          navigator.vibrate([35, 45, 30]); // Distinct double-pulse for buttons
        } else if (type === "medium") {
          navigator.vibrate(30);           // Solid pulse for tabs/select
        } else {
          navigator.vibrate(22);           // Crisp single tap
        }
      } catch(err) {}
    };

    // Chrome-compliant universal pointer listener
    function handleGesture(e) {
      const target = e.target.closest("a, button, [role="button"], select, input, .master-card, .univ-category-pill");
      if (!target) return;

      const txt = (target.textContent || "").toLowerCase();
      if (txt.includes("apply") || txt.includes("pdf") || txt.includes("whatsapp") || txt.includes("telegram") || target.hasAttribute("data-haptic-action")) {
        window.triggerHaptic("action");
      } else if (target.tagName === "SELECT" || target.classList.contains("active-pill")) {
        window.triggerHaptic("medium");
      } else {
        window.triggerHaptic("light");
      }
    }

    // pointerdown fires immediately upon contact without Chrome restrictions
    document.addEventListener("pointerdown", handleGesture, { passive: true, capture: true });
  })();
</script>

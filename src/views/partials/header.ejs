<!DOCTYPE html>
<html lang="hi-en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : settings.siteName %></title>
  <% if (typeof description !== 'undefined' && description) { %><meta name="description" content="<%= description %>"><% } %>
  <% if (typeof keywords !== 'undefined' && keywords && keywords.length) { %><meta name="keywords" content="<%= keywords.join(', ') %>"><% } %>

  <% if (typeof noindex !== 'undefined' && noindex) { %>
    <meta name="robots" content="noindex,follow">
  <% } else { %>
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1">
  <% } %>

  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>

  <!-- Open Graph -->
  <% if (typeof description !== 'undefined' && description) { %>
    <meta property="og:site_name" content="<%= settings.siteName %>">
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : settings.siteName %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:type" content="<%= typeof post !== 'undefined' && post ? 'article' : 'website' %>">
    <meta property="og:locale" content="en_IN">
    <meta property="og:image" content="<%= (typeof siteUrl !== 'undefined' ? siteUrl : '') %>/favicon.svg">
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : settings.siteName %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= (typeof siteUrl !== 'undefined' ? siteUrl : '') %>/favicon.svg">
  <% } %>

    <meta name="geo.region" content="IN">
  <meta name="geo.placename" content="India">
  <meta name="rating" content="general">
  <meta name="revisit-after" content="1 days">
  <meta name="theme-color" content="#060913">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="<%= settings.siteName %> — Latest Updates" href="/feed.xml">

  <!-- Sitewide structured data (Organization + WebSite w/ sitelinks search box) -->
  <%- include('site-jsonld') %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              bg: '#060913', card: '#0E172A', cardHover: '#131F38',
              border: '#1E293B', borderBright: '#334155',
              accent: '#6366F1', cyan: '#06B6D4', emerald: '#10B981',
              amber: '#F59E0B', rose: '#F43F5E'
            }
          },
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'], mono: ['"JetBrains Mono"', 'monospace'] }
        }
      }
    }
  </script>
  
  
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap");

    body {
      background-color: #050811 !important;
      background-image: 
        radial-gradient(at 50% 0%, rgba(99, 102, 241, 0.12) 0px, transparent 50%),
        radial-gradient(at 100% 0%, rgba(6, 182, 212, 0.08) 0px, transparent 40%),
        radial-gradient(at 0% 25%, rgba(139, 92, 246, 0.06) 0px, transparent 40%) !important;
      background-attachment: fixed !important;
      color: #E2E8F0;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }

    /* Figma Surface Glass */
    .figma-glass {
      background: rgba(13, 20, 36, 0.7) !important;
      backdrop-filter: blur(16px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    
    .figma-glass:hover {
      border-color: rgba(99, 102, 241, 0.35) !important;
      box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5), 0 0 20px -2px rgba(99, 102, 241, 0.15) !important;
    }

    /* Glow Pill */
    .figma-pill {
      background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.1);
    }
  </style>



<style>
  /* Advanced Figma UI Token Styles */
  .figma-surface {
    background: rgba(11, 19, 43, 0.78) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
  }
  .figma-glass-pill {
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    backdrop-filter: blur(12px) !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .figma-glass-pill:hover, .figma-glass-pill:active {
    background: rgba(255, 255, 255, 0.09) !important;
    border-color: rgba(99, 102, 241, 0.4) !important;
    transform: translateY(-1px);
  }
  .figma-gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .figma-table-cell {
    border-color: rgba(255, 255, 255, 0.06) !important;
  }
</style>


<script>
  // Unified Figma tactile haptic engine
  window.triggerHaptic = function(pattern) {
    if (!('vibrate' in navigator)) return;
    try {
      if (pattern === 'light' || pattern === 'selection') {
        navigator.vibrate(10);
      } else if (pattern === 'medium') {
        navigator.vibrate(22);
      } else if (pattern === 'action' || pattern === 'heavy') {
        navigator.vibrate([18, 35, 25]);
      } else if (pattern === 'success') {
        navigator.vibrate([12, 28, 16]);
      } else if (typeof pattern === 'number' || Array.isArray(pattern)) {
        navigator.vibrate(pattern);
      } else {
        navigator.vibrate(10);
      }
    } catch(e) {}
  };

  // Global Event Delegation for touch devices sitewide
  (function initGlobalHaptics() {
    function handleTouch(e) {
      const target = e.target.closest('button, a, select, input, .master-card, .univ-category-pill, [onclick]');
      if (!target) return;

      // Class-based intensity selection
      if (target.classList.contains('active-pill') || target.hasAttribute('data-haptic-action') || 
          target.innerText.includes('Apply Online') || target.innerText.includes('PDF') ||
          target.innerText.includes('WhatsApp') || target.innerText.includes('Telegram')) {
        window.triggerHaptic('action');
      } else if (target.tagName === 'SELECT' || target.getAttribute('role') === 'button') {
        window.triggerHaptic('medium');
      } else {
        window.triggerHaptic('light');
      }
    }

    document.addEventListener('touchstart', handleTouch, { passive: true, capture: true });
  })();
</script>





<style id="figma-micro-interactions">
  /* Force touch event processing on mobile */
  html, body {
    -webkit-tap-highlight-color: transparent !important;
  }

  /* Interactive Elements Target */
  a, button, select, 
  .interactive-tap,
  .master-card,
  .univ-category-pill,
  [role="button"] {
    transition: transform 0.14s cubic-bezier(0.2, 0.9, 0.3, 1.2) !important;
    will-change: transform;
    display: inline-block;
  }

  /* Applied dynamically on touch */
  .figma-touch-active {
    transform: scale(0.96) !important;
    opacity: 0.92 !important;
  }
</style>

<script>
  // Mobile Touch Zoom Engine (Bypasses Chrome :active freeze)
  (function() {
    let activeEl = null;

    document.addEventListener("touchstart", function(e) {
      const el = e.target.closest("a, button, select, .master-card, .univ-category-pill, [role="button"], [onclick]");
      if (!el) return;
      activeEl = el;
      el.classList.add("figma-touch-active");
    }, { passive: true, capture: true });

    function removeTouch() {
      if (activeEl) {
        activeEl.classList.remove("figma-touch-active");
        activeEl = null;
      }
    }

    document.addEventListener("touchend", removeTouch, { passive: true });
    document.addEventListener("touchcancel", removeTouch, { passive: true });
  })();
</script>

</head>
<body class="bg-brand-bg text-slate-200 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-accent selection:text-white">


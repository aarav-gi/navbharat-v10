<%- include('../partials/header') %>

<main class="max-w-4xl mx-auto px-4 py-8 flex-1 w-full pb-20">
  <%- include('nav') %>

  <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl">

    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
      <div>
        <h1 class="text-xl font-black text-white flex items-center gap-2">
          <span>✏️ Edit & Verify Post Details</span>
          <span class="px-2 py-0.5 rounded text-[11px] font-mono <%= source === 'queue' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' %>">
            Source: <%= source === 'queue' ? 'Review Queue (Pending)' : 'Live Post' %>
          </span>
        </h1>
        <p class="text-xs text-slate-400 mt-1">Fields adapt to the selected category.</p>
      </div>
      <a href="<%= secretUrl %>/<%= source === 'queue' ? 'queue' : 'posts' %>" class="text-xs bg-white/5 hover:bg-white/10 text-slate-300 px-3 py-1.5 rounded-xl border border-white/10 transition">
        ← Back
      </a>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs p-3 rounded-xl mb-4">
        <ul class="list-disc list-inside">
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form action="<%= secretUrl %>/update" method="POST" class="space-y-6 text-xs">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="id" value="<%= item.id %>">
      <input type="hidden" name="source" value="<%= source %>">

      <!-- Common fields -->
      
      <!-- Admin Only: Auto Re-check / Expiry Control -->
      <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl mb-4">
        <div class="flex items-center justify-between">
          <div>
            <label class="block text-amber-300 font-semibold text-xs">⏳ Auto Re-Check Date (Admin Only)</label>
            <p class="text-[11px] text-slate-400">इस तारीख को यह पोस्ट वेबसाइट से हटकर स्वतः दोबारा Review Queue में आ जाएगी।</p>
          </div>
          <div class="w-1/2 md:w-1/3">
            <input type="date" name="recheck_at" value="<%= item.recheck_at ? item.recheck_at.split("T")[0] : "" %>" class="w-full bg-[#161F30] border border-amber-500/30 rounded-xl px-3 py-2 text-white text-xs">
          </div>
        </div>
      </div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Category *</label>
          <%
  const currentCat = String(item.category || "").toLowerCase().replace(/\s+/g, "-");
  const isResults = currentCat === "results" || currentCat === "result";
  const isAdmit = currentCat === "admit-card" || currentCat === "admitcard";
  const isAns = currentCat === "answer-key" || currentCat === "answerkey";
  const isSyllabus = currentCat === "syllabus";
  const isJobs = !isResults && !isAdmit && !isAns && !isSyllabus;
%>
          <select id="categorySelect" name="category" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2.5 text-white">
            <option value="latest-jobs" <%= isJobs ? "selected" : "" %>>Latest Jobs</option>
            <option value="admit-card" <%= isAdmit ? "selected" : "" %>>Admit Card</option>
            <option value="results" <%= isResults ? "selected" : "" %>>Results</option>
            <option value="answer-key" <%= isAns ? "selected" : "" %>>Answer Key</option>
            <option value="syllabus" <%= isSyllabus ? "selected" : "" %>>Syllabus</option>
          </select>
        </div>
        <div class="md:col-span-2">
          <label class="block text-slate-300 mb-1 font-semibold">Organization / Board *</label>
          <input type="text" name="organization" value="<%= item.organization %>" required class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2.5 text-white">
        </div>
      </div>

      <div>
        <label id="titleLabel" class="block text-slate-300 mb-1 font-semibold">Post Full Title *</label>
        <input id="titleInput" type="text" name="title" value="<%= item.title %>" required class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2.5 text-white font-medium">
      </div>

      <div>
        <label class="block text-slate-300 mb-1 font-semibold">Description / Short Summary</label>
        <textarea name="description" rows="3" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white"><%= item.description || '' %></textarea>
        <p id="descHint" class="text-[10px] text-slate-500 mt-1"></p>
      </div>

      <!-- ===================== LATEST JOBS ONLY ===================== -->
      <div class="cat-section space-y-6" data-cats="latest-jobs">

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Total Posts</label>
            <input type="text" name="totalPosts" value="<%= item.totalPosts %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Application Start Date</label>
            <input type="text" name="applicationStart" value="<%= item.applicationStart %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-rose-400 mb-1 font-semibold">Last Date to Apply</label>
            <input type="text" name="applicationEnd" value="<%= item.applicationEnd %>" class="w-full bg-[#161F30] border border-rose-500/30 rounded-xl px-3 py-2 text-white font-mono font-bold">
          </div>
        </div>

        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Age Limit Criteria</label>
          <input type="text" name="ageLimit" value="<%= item.ageLimit %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>

        <div class="border border-amber-500/20 rounded-xl p-4 bg-amber-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-bold text-amber-300 uppercase tracking-wider">Application Fee Matrix</h3>
            <button type="button" onclick="addFeeRow()" class="px-2.5 py-1 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-[11px] font-bold transition">+ Add Fee Row</button>
          </div>
          <div id="feeContainer" class="space-y-2">
            <% (item.feeStructure && item.feeStructure.length > 0 ? item.feeStructure : [{label:'General / OBC / EWS', amount:'₹100/-'},{label:'SC / ST / Reserved', amount:'₹0/- (Exempted)'}]).forEach(f => { %>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-2 fee-row">
                <input type="text" name="fee_label[]" value="<%= f.label %>" placeholder="Category Label" class="md:col-span-7 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
                <input type="text" name="fee_amount[]" value="<%= f.amount %>" placeholder="Amount" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono">
                <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- DYNAMIC IMPORTANT DATES BUILDER (Sarkari Result Style) -->
        <div class="border border-cyan-500/30 rounded-xl p-4 bg-[#111A2E]/60">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-xs font-bold text-cyan-300 uppercase tracking-wider flex items-center gap-1.5">
                <span>📅</span> Important Dates / महत्वपूर्ण तिथियां (Customizable)
              </h3>
              <p class="text-[11px] text-slate-400">अपनी जरूरत अनुसार नई तारीखें जोड़ें या हटाएं (जैसे Pay Fee Date, Exam Date, Correction Date)</p>
            </div>
            <button type="button" onclick="addDateRow()" class="px-2.5 py-1 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-[11px] font-bold transition shadow">
              + Add Date Row
            </button>
          </div>
          <div id="datesContainer" class="space-y-2">
            <% 
              const defDates = [
                { label: "Application Begin", value: item.applicationStart || "Available Now" },
                { label: "Last Date for Apply", value: item.applicationEnd || "" },
                { label: "Pay Exam Fee Last Date", value: item.applicationEnd || "" },
                { label: "Correction Date", value: "As per Schedule" },
                { label: "Exam Date", value: "As per Schedule" }
              ];
              const activeDates = (item.importantDates && item.importantDates.length > 0) ? item.importantDates : defDates;
              activeDates.forEach(d => { 
            %>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
                <input type="text" name="date_label[]" value="<%= d.label %>" placeholder="Date Label (e.g. Exam Date)" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-medium text-xs">
                <input type="text" name="date_val[]" value="<%= d.value %>" placeholder="Date Value (e.g. 15/11/2026)" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-cyan-300 text-xs">
                <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
              </div>
            <% }) %>
          </div>
        </div>

        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Educational Eligibility Summary</label>
          <textarea name="qualifications" rows="2" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white leading-relaxed"><%= item.qualifications %></textarea>
        </div>

        <div class="border border-indigo-500/20 rounded-xl p-4 bg-indigo-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <div class="flex-1 mr-4">
       <label class="block text-[11px] text-indigo-300 font-bold uppercase mb-1">Section Title (कस्टमाइज़ेबल शीर्षक):</label>
       <input type="text" name="vacancyTitle" value="<%= item.vacancyTitle || 'District-Wise Vacancy Details (जनपदवार रिक्तियां)' %>" placeholder="e.g. Post-Wise Vacancy / Trade-Wise Vacancy / District-Wise" class="w-full bg-[#161F30] border border-indigo-500/40 rounded-lg px-2.5 py-1.5 text-xs text-white font-bold">
     </div>
            <button type="button" onclick="addVacancyRow()" class="px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-[11px] font-bold transition">+ Add District Row</button>
          </div>
          <div id="vacancyContainer" class="space-y-2">
            <% (item.vacancies && item.vacancies.length > 0 ? item.vacancies : [{post:'All Cadre Posts', seats: item.totalPosts, lastDate: item.applicationEnd}]).forEach(v => { %>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-2 vacancy-row">
                <input type="text" name="vac_post[]" value="<%= v.post %>" placeholder="District / Post Name" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
                <input type="text" name="vac_seats[]" value="<%= v.seats %>" placeholder="Seats" class="md:col-span-2 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-cyan-300">
                <input type="text" name="vac_lastDate[]" value="<%= v.lastDate || item.applicationEnd %>" placeholder="Last Date" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-rose-300">
                <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Apply Online Link</label>
            <input type="url" name="applyUrl" value="<%= item.applyUrl || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Notification PDF Link</label>
            <input type="url" name="notificationPdf" value="<%= item.notificationPdf || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
          </div>
        </div>
      </div>

      <!-- ===================== ADMIT CARD ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="admit-card">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Exam Date</label>
            <input type="text" name="applicationEnd" value="<%= item.applicationEnd %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Admit Card Download Link</label>
            <input type="url" name="applyUrl" value="<%= item.applyUrl || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
          </div>
        </div>
      </div>

      <!-- ===================== RESULTS ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="results">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Result PDF / Link</label>
          <input type="url" name="notificationPdf" value="<%= item.notificationPdf || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
        </div>
      </div>

      <!-- ===================== ANSWER KEY ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="answer-key">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Answer Key PDF / Link</label>
            <input type="url" name="notificationPdf" value="<%= item.notificationPdf || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Objection Last Date (optional)</label>
            <input type="text" name="applicationEnd" value="<%= item.applicationEnd %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
        </div>
      </div>

      <!-- ===================== SYLLABUS ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="syllabus">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Syllabus PDF / Link</label>
          <input type="url" name="syllabusPdf" value="<%= item.syllabusPdf || '' %>" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white font-mono">
        </div>
      </div>

      <!-- ACTION BUTTONS -->
      <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-white/10">
        
      <!-- Per-Post Affiliate Books Section -->
      <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 mb-6">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
          <div>
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
              <span>📚</span> Recommended Affiliate Books (Exam Specific)
            </h2>
            <p class="text-[11px] text-slate-400">Is post se judi recommend kitabein aur affiliate link dalein.</p>
          </div>
          <button type="button" onclick="addBookRow()" class="text-xs bg-indigo-600/20 text-indigo-400 hover:bg-indigo-600 hover:text-white px-3 py-1.5 rounded-lg border border-indigo-500/30 transition font-semibold">
            + Add Book
          </button>
        </div>

        <div id="booksContainer" class="space-y-3">
          <% if (item.books && item.books.length > 0) { %>
            <% item.books.forEach(function(b) { %>
              <div class="grid grid-cols-1 md:grid-cols-12 gap-2 book-row bg-[#161F30] p-3 rounded-xl border border-white/5 items-center">
                <div class="md:col-span-5">
                  <label class="block text-[10px] text-slate-400 mb-0.5">Book Title</label>
                  <input type="text" name="book_name[]" value="<%= b.title %>" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
                </div>
                <div class="md:col-span-2">
                  <label class="block text-[10px] text-slate-400 mb-0.5">Price</label>
                  <input type="text" name="book_price[]" value="<%= b.price || '' %>" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs">
                </div>
                <div class="md:col-span-4">
                  <label class="block text-[10px] text-slate-400 mb-0.5">Affiliate Link URL</label>
                  <input type="url" name="book_url[]" value="<%= b.url %>" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
                </div>
                <div class="md:col-span-1 flex items-end justify-center pt-2 md:pt-4">
                  <button type="button" onclick="removeRow(this)" class="bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg p-1.5 w-full flex items-center justify-center font-bold text-xs">✕</button>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    
      <button type="submit" name="actionType" value="save_only" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-200 font-bold transition">
          💾 Save Changes (Keep in <%= source === 'queue' ? 'Queue' : 'Live' %>)
        </button>
        <button type="submit" name="actionType" value="publish_live" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 text-white font-extrabold transition shadow-lg shadow-emerald-600/30">
          🚀 Save & Publish to Live Site
        </button>
      </div>

    </form>

  </div>
<script>
  function addBookRow(name = '', price = '', url = '') {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 book-row bg-[#161F30] p-3 rounded-xl border border-white/5 items-center';
    div.innerHTML = `
      <div class="md:col-span-5">
        <label class="block text-[10px] text-slate-400 mb-0.5">Book Title</label>
        <input type="text" name="book_name[]" value="${name}" placeholder="e.g. Lucent General Hindi or SSC Guide" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-[10px] text-slate-400 mb-0.5">Price</label>
        <input type="text" name="book_price[]" value="${price}" placeholder="e.g. ₹299" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs">
      </div>
      <div class="md:col-span-4">
        <label class="block text-[10px] text-slate-400 mb-0.5">Affiliate Link URL</label>
        <input type="url" name="book_url[]" value="${url}" placeholder="https://amzn.to/..." class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
      </div>
      <div class="md:col-span-1 flex items-end justify-center pt-2 md:pt-4">
        <button type="button" onclick="this.closest('.book-row').remove()" class="bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg p-1.5 w-full flex items-center justify-center font-bold text-xs">✕</button>
      </div>
    `;
    document.getElementById('booksContainer').appendChild(div);
  }
</script>
</main>

<script>
  function addFeeRow() {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 fee-row';
    div.innerHTML = `
      <input type="text" name="fee_label[]" placeholder="Category (e.g. Female / EWS / NCC)" class="md:col-span-7 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="fee_amount[]" placeholder="Fee (e.g. ₹50/-)" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono">
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById('feeContainer').appendChild(div);
  }

  function addDateRow() {
      const container = document.getElementById("datesContainer");
      const row = document.createElement("div");
      row.className = "grid grid-cols-1 md:grid-cols-12 gap-2 date-row";
      row.innerHTML = '<input type="text" name="date_label[]" placeholder="Date Label (e.g. Admit Card Date)" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-medium text-xs">' +
        '<input type="text" name="date_val[]" placeholder="Date Value (e.g. October 2026)" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-cyan-300 text-xs">' +
        '<button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>';
      container.appendChild(row);
    }

    function addVacancyRow() {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 vacancy-row';
    div.innerHTML = `
      <input type="text" name="vac_post[]" placeholder="District / Post Name" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="vac_seats[]" placeholder="Seats" class="md:col-span-2 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-cyan-300">
      <input type="text" name="vac_lastDate[]" placeholder="Last Date" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-mono text-rose-300">
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById('vacancyContainer').appendChild(div);
  }

  function removeRow(btn) {
    btn.parentElement.remove();
  }
</script>

<%- include('../partials/header') %>

<main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full pb-20">
  <%- include('nav') %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-5">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Published Posts</span>
      <div class="text-3xl font-black text-white mt-1 font-mono"><%= publishedCount %></div>
    </div>
    <div class="bg-[#0F172A] border border-amber-500/20 rounded-2xl p-5">
      <span class="text-xs font-mono text-amber-300 uppercase tracking-wider">Pending Review</span>
      <div class="text-3xl font-black text-amber-300 mt-1 font-mono"><%= pendingCount %></div>
    </div>
    <div class="bg-[#0F172A] border border-rose-500/20 rounded-2xl p-5">
      <span class="text-xs font-mono text-rose-300 uppercase tracking-wider">Failed Logins (24h)</span>
      <div class="text-3xl font-black text-rose-300 mt-1 font-mono"><%= failedLogins %></div>
    </div>
    <div class="bg-[#0F172A] border border-cyan-500/20 rounded-2xl p-5">
      <span class="text-xs font-mono text-cyan-300 uppercase tracking-wider">Security Events (24h)</span>
      <div class="text-3xl font-black text-cyan-300 mt-1 font-mono"><%= securityEventsToday %></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-5">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Today's Pageviews</span>
      <div class="text-2xl font-black text-white mt-1 font-mono"><%= todayViews %></div>
    </div>
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-5">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Today's Unique Visitors</span>
      <div class="text-2xl font-black text-white mt-1 font-mono"><%= todayUnique %></div>
    </div>
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-5">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">All-Time Pageviews</span>
      <div class="text-2xl font-black text-white mt-1 font-mono"><%= totalViews %></div>
    </div>
  </div>

  <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl">
    <h2 class="text-sm font-bold text-white mb-4">Quick Links</h2>
    <div class="flex flex-wrap gap-2 text-xs">
      <a href="<%= secretUrl %>/queue" class="px-3 py-1.5 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/30">Review Queue</a>
      <a href="<%= secretUrl %>/posts" class="px-3 py-1.5 rounded-xl bg-white/5 text-slate-200 border border-white/10">Manage Posts</a>
      <a href="<%= secretUrl %>/analytics" class="px-3 py-1.5 rounded-xl bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">Analytics</a>
      <a href="<%= secretUrl %>/audit" class="px-3 py-1.5 rounded-xl bg-indigo-500/15 text-indigo-300 border border-indigo-500/30">Audit &amp; Security Log</a>
      <a href="<%= secretUrl %>/settings" class="px-3 py-1.5 rounded-xl bg-white/5 text-slate-200 border border-white/10">Settings</a>
    </div>
  </div>

  <!-- PLATFORM TRAFFIC & AFFILIATE CLICKS ENGINE -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    
    <!-- Platform Sources Breakdown -->
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl">
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
        <div>
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>🌐 Platform Sources (Traffic Breakdown)</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">Telegram, WhatsApp, Instagram & Social incoming traffic</p>
        </div>
        <span class="text-[11px] font-mono bg-indigo-500/10 text-indigo-300 border border-indigo-500/30 px-2.5 py-1 rounded-lg">Real-Time</span>
      </div>

      <div class="divide-y divide-white/[0.06]">
        <% (platformStats || []).forEach(function(item) { %>
          <div class="py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-xl"><%= item.icon %></span>
              <div>
                <span class="text-sm font-semibold <%= item.color %>"><%= item.name %></span>
                <div class="text-[11px] text-slate-400">All-time: <strong class="text-white"><%= item.total %></strong> visits</div>
              </div>
            </div>
            <div class="text-right">
              <span class="text-base font-black text-white font-mono"><%= item.today %></span>
              <span class="text-[10px] text-emerald-400 block font-mono">Today</span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Affiliate Books & Study Material Clicks -->
    <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
          <div>
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <span>📖 Affiliate Book Clicks</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Clicks on candidate preparation books & guides</p>
          </div>
          <div class="text-right">
            <span class="text-xs font-mono text-emerald-300 font-bold block"><%= totalBookClicks || 0 %> Clicks</span>
            <span class="text-[10px] text-slate-400 uppercase font-mono">Total Generated</span>
          </div>
        </div>

        <div class="space-y-3 max-h-[290px] overflow-y-auto pr-1">
          <% if (!affiliateClicks || affiliateClicks.length === 0) { %>
            <div class="py-10 text-center text-xs text-slate-500 font-mono">No affiliate book clicks recorded yet.</div>
          <% } else { %>
            <% affiliateClicks.forEach(function(book) { %>
              <div class="p-3 rounded-xl bg-white/[0.02] border border-white/[0.06] flex items-center justify-between gap-3">
                <div class="min-w-0">
                  <div class="text-xs font-semibold text-white truncate"><%= book.book_title %></div>
                  <div class="text-[10px] text-slate-400 truncate mt-0.5 font-mono"><%= book.target_url %></div>
                </div>
                <div class="text-right shrink-0">
                  <span class="text-sm font-black text-emerald-400 font-mono"><%= book.clicks %></span>
                  <span class="text-[10px] text-slate-500 block">clicks</span>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
      
      <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] text-slate-400 flex items-center justify-between">
        <span>Affiliate tracking gateway active at <code class="text-cyan-400">/go/book</code></span>
        <span class="text-emerald-400 font-medium">Auto-Redirect 302</span>
      </div>
    </div>

  </div>

</main>

<%- include('../partials/footer') %>

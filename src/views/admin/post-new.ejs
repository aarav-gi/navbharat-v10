<%- include('../partials/header') %>

<main class="max-w-4xl mx-auto px-4 py-8 flex-1 w-full">
  <%- include('nav') %>

  <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl">
    <div class="border-b border-white/10 pb-4 mb-6">
      <h1 class="text-xl font-bold text-white">Create New Post</h1>
      <p class="text-xs text-slate-400 mt-1">Fields adapt to the selected category — a Result only asks for a summary and a PDF link; a Job asks for the full recruitment details.</p>
    </div>

    <% if (typeof errors !== 'undefined' && errors && errors.length) { %>
      <div class="bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs p-3 rounded-xl mb-4">
        <ul class="list-disc list-inside">
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form action="<%= secretUrl %>/create" method="POST" class="space-y-6 text-xs">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Common fields, always shown -->
      
      <!-- Admin Only: Auto Re-check / Expiry Control -->
      <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl mb-4">
        <div class="flex items-center justify-between">
          <div>
            <label class="block text-amber-300 font-semibold text-xs">⏳ Auto Re-Check Date (Admin Only)</label>
            <p class="text-[11px] text-slate-400">इस तारीख को यह पोस्ट वेबसाइट से हटकर स्वतः दोबारा Review Queue में आ जाएगी।</p>
          </div>
          <div class="w-1/2 md:w-1/3">
            <input type="date" name="recheck_at" class="w-full bg-[#161F30] border border-amber-500/30 rounded-xl px-3 py-2 text-white text-xs">
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Category *</label>
          <select id="categorySelect" name="category" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2.5 text-white">
            <option value="latest-jobs">Latest Jobs</option>
            <option value="admit-card">Admit Card</option>
            <option value="results">Results</option>
            <option value="answer-key">Answer Key</option>
            <option value="syllabus">Syllabus</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Organization / Board *</label>
          <input type="text" name="organization" required placeholder="e.g. SSC / Railway / UPSC / UKSSSC" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
      </div>

      <div>
        <label id="titleLabel" class="block text-slate-300 mb-1 font-semibold">Post Full Title *</label>
        <input id="titleInput" type="text" name="title" required placeholder="e.g. SSC CGL 2026 Combined Graduate Level Recruitment" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
      </div>

      <div>
        <label class="block text-slate-300 mb-1 font-semibold">Description / Short Summary</label>
        <textarea name="description" rows="3" placeholder="Short summary shown on the page" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white"></textarea>
        <p id="descHint" class="text-[10px] text-slate-500 mt-1"></p>
      </div>

      <!-- ===================== LATEST JOBS ONLY ===================== -->
      <div class="cat-section space-y-6" data-cats="latest-jobs">

        <div>
            <label class="block text-slate-300 mb-1 font-semibold">Total Posts</label>
            <input type="text" name="totalPosts" placeholder="e.g. 14,582" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>

        <!-- Important Dates matrix -->
        <div class="border border-cyan-500/20 rounded-xl p-4 bg-cyan-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-xs font-bold text-cyan-300 uppercase tracking-wider">Important Dates Matrix</h3>
              <p class="text-[10px] text-slate-400">Edit label text (Application Begin, Last Date, Correction, Exam Date) and add rows as needed.</p>
            </div>
            <button type="button" onclick="addDateRow()" class="px-2.5 py-1 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-[11px] font-bold transition">+ Add Date Row</button>
          </div>
          <div id="datesContainer" class="space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
              <input type="text" name="date_label[]" value="Application Begin / प्रारंभ तिथि" placeholder="Date Label" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="date_val[]" value="Available Now" placeholder="Date Value" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
              <input type="text" name="date_label[]" value="Last Date for Apply / अंतिम तिथि" placeholder="Date Label" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white font-semibold text-rose-400">
              <input type="text" name="date_val[]" placeholder="e.g. 15 October 2026" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
              <input type="text" name="date_label[]" value="Pay Exam Fee Last Date" placeholder="Date Label" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="date_val[]" placeholder="e.g. 15 October 2026" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
              <input type="text" name="date_label[]" value="Correction Date" placeholder="Date Label" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="date_val[]" placeholder="e.g. As per Schedule" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 date-row">
              <input type="text" name="date_label[]" value="Exam Date / परीक्षा तिथि" placeholder="Date Label" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="date_val[]" value="As per Schedule" placeholder="Date Value" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
          </div>
        </div>
        </div>

        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Age Limit Criteria</label>
          <input type="text" name="ageLimit" placeholder="e.g. 18 to 32 Years (as on 01/01/2026)" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>

        <!-- Fee matrix -->
        <div class="border border-amber-500/20 rounded-xl p-4 bg-amber-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-xs font-bold text-amber-300 uppercase tracking-wider">Application Fee Matrix</h3>
              <p class="text-[10px] text-slate-400">Edit label text (SC, ST, OBC, Female, NCC etc.) and add as many rows as needed.</p>
            </div>
            <button type="button" onclick="addFeeRow()" class="px-2.5 py-1 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-[11px] font-bold transition">+ Add Category Fee</button>
          </div>
          <div id="feeContainer" class="space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 fee-row">
              <input type="text" name="fee_label[]" value="General / OBC / EWS" placeholder="Category Label" class="md:col-span-7 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="fee_amount[]" value="₹100/-" placeholder="Fee Amount" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 fee-row">
              <input type="text" name="fee_label[]" value="SC / ST" placeholder="Category Label" class="md:col-span-7 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="fee_amount[]" value="₹0/- (Exempted)" placeholder="Fee Amount" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Educational Eligibility Summary</label>
          <textarea name="qualifications" rows="2" placeholder="e.g. Bachelor Degree in any stream from recognized university." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white"></textarea>
        </div>

        <!-- Vacancy breakdown -->
        <div class="border border-indigo-500/20 rounded-xl p-4 bg-indigo-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <div class="w-full mr-4">
              <label class="block text-[10px] text-indigo-300 font-bold uppercase tracking-wider mb-1">Section Heading Title (Customizable)</label>
              <input type="text" name="vacancyTitle" value="District-Wise Vacancy Details (जनपदवार रिक्तियां)" placeholder="e.g. District-Wise / Post-Wise / Trade-Wise Vacancy Details" class="w-full bg-[#161F30] border border-white/10 rounded-lg px-3 py-1.5 text-white text-xs">
            </div>
            <button type="button" onclick="addVacancyRow()" class="px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-[11px] font-bold transition">+ Add Post Row</button>
          </div>
          <div id="vacancyContainer" class="space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-2 vacancy-row">
              <input type="text" name="vac_post[]" placeholder="Post Name (e.g. Assistant Section Officer)" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="vac_seats[]" placeholder="Seats (e.g. 1,240)" class="md:col-span-2 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <input type="text" name="vac_eligibility[]" placeholder="Eligibility (e.g. Bachelor Degree)" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
              <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Apply Online Link</label>
            <input type="url" name="applyUrl" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Notification PDF Link</label>
            <input type="url" name="notificationPdf" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
        </div>

        <!-- Extra official links -->
        <div class="border border-cyan-500/20 rounded-xl p-4 bg-cyan-500/[0.02]">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-bold text-cyan-300 uppercase tracking-wider">Other Official Links (optional)</h3>
            <button type="button" onclick="addLinkRow()" class="px-2.5 py-1 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-[11px] font-bold transition">+ Add Another Link</button>
          </div>
          <div id="linksContainer" class="space-y-2"></div>
        </div>
      </div>

      <!-- ===================== ADMIT CARD ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="admit-card">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Exam Date</label>
            <input type="text" name="applicationEnd" placeholder="e.g. 12 October 2026" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Admit Card Download Link *</label>
            <input type="url" name="applyUrl" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
        </div>
      </div>

      <!-- ===================== RESULTS ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="results">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Result PDF / Link *</label>
          <input type="url" name="notificationPdf" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          <p class="text-[10px] text-slate-500 mt-1">That's it — results intentionally skip vacancy tables, fees and age limits.</p>
        </div>
      </div>

      <!-- ===================== ANSWER KEY ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="answer-key">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Answer Key PDF / Link *</label>
            <input type="url" name="notificationPdf" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
          <div>
            <label class="block text-slate-300 mb-1 font-semibold">Objection Last Date (optional)</label>
            <input type="text" name="applicationEnd" placeholder="e.g. 20 October 2026" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          </div>
        </div>
      </div>

      <!-- ===================== SYLLABUS ONLY ===================== -->
      <div class="cat-section space-y-4" data-cats="syllabus">
        <div>
          <label class="block text-slate-300 mb-1 font-semibold">Syllabus PDF / Link *</label>
          <input type="url" name="syllabusPdf" placeholder="https://..." class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
          <p class="text-[10px] text-slate-500 mt-1">That's it — syllabus pages intentionally skip every job-application field.</p>
        </div>
      </div>

      
      <!-- Per-Post Affiliate Books Section -->
      <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 mb-6">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-4">
          <div>
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
              <span>📚</span> Recommended Affiliate Books (Exam Specific)
            </h2>
            <p class="text-[11px] text-slate-400">Is specific job/syllabus se judi recommend kitabein aur apna direct affiliate link dalein.</p>
          </div>
          <button type="button" onclick="addBookRow()" class="text-xs bg-indigo-600/20 text-indigo-400 hover:bg-indigo-600 hover:text-white px-3 py-1.5 rounded-lg border border-indigo-500/30 transition font-semibold">
            + Add Book
          </button>
        </div>

        <div id="booksContainer" class="space-y-3">
          <!-- Dynamically added rows -->
        </div>
      </div>

      
    


    <button type="submit" class="w-full bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-500 hover:to-cyan-500 text-white font-bold py-3.5 rounded-xl transition shadow-xl shadow-indigo-600/30 text-xs">
        🚀 Publish Post to Live Site & Sitemap
      </button>

    </form>
  </div>
</main>

<script>
    function addDateRow() {
    const div = document.createElement("div");
    div.className = "grid grid-cols-1 md:grid-cols-12 gap-2 date-row";
    div.innerHTML = `
      <input type="text" name="date_label[]" placeholder="Date Label (e.g. Answer Key Date)" class="md:col-span-6 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="date_val[]" placeholder="Date Value (e.g. November 2026)" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById("datesContainer").appendChild(div);
  }

  function addFeeRow() {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 fee-row';
    div.innerHTML = `
      <input type="text" name="fee_label[]" placeholder="Category (e.g. ST / NCC / Ex-Servicemen)" class="md:col-span-7 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="fee_amount[]" placeholder="Fee (e.g. ₹50/- or Free)" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById('feeContainer').appendChild(div);
  }

  function addVacancyRow() {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 vacancy-row';
    div.innerHTML = `
      <input type="text" name="vac_post[]" placeholder="Post Name" class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="vac_seats[]" placeholder="Seats" class="md:col-span-2 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="text" name="vac_eligibility[]" placeholder="Eligibility" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById('vacancyContainer').appendChild(div);
  }

  
  function addBookRow(name = '', price = '', url = '') {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 book-row bg-[#161F30] p-3 rounded-xl border border-white/5 items-center';
    div.innerHTML = `
      <div class="md:col-span-5">
        <label class="block text-[10px] text-slate-400 mb-0.5">Book Title</label>
        <input type="text" name="book_name[]" value="${name}" placeholder="e.g. Lucent General Hindi or SSC Guide" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
      </div>
      <div class="md:col-span-2">
        <label class="block text-[10px] text-slate-400 mb-0.5">Price</label>
        <input type="text" name="book_price[]" value="${price}" placeholder="e.g. ₹299" class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs">
      </div>
      <div class="md:col-span-4">
        <label class="block text-[10px] text-slate-400 mb-0.5">Affiliate Link URL</label>
        <input type="url" name="book_url[]" value="${url}" placeholder="https://amzn.to/..." class="w-full bg-[#0F172A] border border-white/10 rounded-lg px-2.5 py-1.5 text-white text-xs" required>
      </div>
      <div class="md:col-span-1 flex items-end justify-center pt-2 md:pt-4">
        <button type="button" onclick="removeRow(this)" class="bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg p-1.5 w-full flex items-center justify-center font-bold text-xs">✕</button>
      </div>
    `;
    document.getElementById('booksContainer').appendChild(div);
  }

  function addLinkRow() {
    const div = document.createElement('div');
    div.className = 'grid grid-cols-1 md:grid-cols-12 gap-2 link-row';
    div.innerHTML = `
      <input type="text" name="link_name[]" placeholder="Link Name (e.g. Corrigendum)" class="md:col-span-4 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <input type="url" name="link_url[]" placeholder="https://..." class="md:col-span-5 bg-[#161F30] border border-white/10 rounded-lg px-2.5 py-2 text-white">
      <select name="link_type[]" class="md:col-span-2 bg-[#161F30] border border-white/10 rounded-lg px-2 py-2 text-white">
        <option value="secondary">Secondary</option>
        <option value="primary">Primary (High CTR)</option>
      </select>
      <button type="button" onclick="removeRow(this)" class="md:col-span-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 rounded-lg flex items-center justify-center font-bold text-sm">✕</button>
    `;
    document.getElementById('linksContainer').appendChild(div);
  }

  function removeRow(btn) {
    btn.parentElement.remove();
  }
</script>

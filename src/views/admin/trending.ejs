<%- include('../partials/header') %>

<main class="max-w-5xl mx-auto px-4 py-8 flex-1 w-full">
  <%- include('nav') %>

  <div class="bg-[#0F172A] border border-white/10 rounded-2xl p-6 shadow-xl mb-6">
    <div class="border-b border-white/10 pb-4 mb-6 flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 class="text-xl font-bold text-white">🔥 Trending Ranking</h1>
        <p class="text-xs text-slate-400 mt-1">
          Score = weighted mix of freshness, view velocity, deadline proximity, engagement,
          update frequency and search demand — not raw views alone. Recomputed automatically every 5 minutes.
        </p>
      </div>
      <form action="<%= secretUrl %>/trending/recompute" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-200 text-xs font-bold transition">
          ↻ Recompute Now
        </button>
      </form>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs p-3 rounded-xl mb-6 text-center font-bold">
        <%= success %>
      </div>
    <% } %>

    <!-- Weight configuration -->
    <form action="<%= secretUrl %>/trending" method="POST" class="space-y-4 text-xs mb-8">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="text-slate-300 font-semibold">Ranking weights (auto-normalized to sum to 1):</p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-slate-400 mb-1">Freshness</label>
          <input type="number" step="0.01" min="0" max="1" name="freshness" value="<%= weights.freshness.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Velocity (growth)</label>
          <input type="number" step="0.01" min="0" max="1" name="velocity" value="<%= weights.velocity.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Deadline proximity</label>
          <input type="number" step="0.01" min="0" max="1" name="deadline" value="<%= weights.deadline.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Engagement (7-day views)</label>
          <input type="number" step="0.01" min="0" max="1" name="engagement" value="<%= weights.engagement.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Update frequency</label>
          <input type="number" step="0.01" min="0" max="1" name="updateFrequency" value="<%= weights.updateFrequency.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
        <div>
          <label class="block text-slate-400 mb-1">Search demand</label>
          <input type="number" step="0.01" min="0" max="1" name="searchDemand" value="<%= weights.searchDemand.toFixed(2) %>" class="w-full bg-[#161F30] border border-white/10 rounded-xl px-3 py-2 text-white">
        </div>
      </div>
      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl transition shadow-lg shadow-indigo-600/30 text-xs mt-2">
        💾 Save Weights
      </button>
    </form>

    <!-- Current ranking with factor breakdown -->
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left border-collapse">
        <thead>
          <tr class="text-slate-400 border-b border-white/10">
            <th class="py-2 pr-3">#</th>
            <th class="py-2 pr-3">Post</th>
            <th class="py-2 pr-3">Score</th>
            <th class="py-2 pr-3">Fresh</th>
            <th class="py-2 pr-3">Velocity</th>
            <th class="py-2 pr-3">Deadline</th>
            <th class="py-2 pr-3">Engage</th>
            <th class="py-2 pr-3">Updates</th>
            <th class="py-2 pr-3">Demand</th>
          </tr>
        </thead>
        <tbody>
          <% trending.forEach((p, i) => { %>
            <tr class="border-b border-white/5 text-slate-300 hover:bg-white/5">
              <td class="py-2 pr-3 font-mono text-slate-500"><%= i + 1 %></td>
              <td class="py-2 pr-3 font-semibold text-slate-100"><%= p.title %></td>
              <td class="py-2 pr-3 font-mono text-amber-400 font-bold"><%= p.score.toFixed(3) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.freshness.toFixed(2) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.velocity.toFixed(2) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.deadline.toFixed(2) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.engagement.toFixed(2) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.updateFrequency.toFixed(2) %></td>
              <td class="py-2 pr-3 font-mono"><%= p.searchDemand.toFixed(2) %></td>
            </tr>
          <% }) %>
          <% if (trending.length === 0) { %>
            <tr><td colspan="9" class="py-6 text-center text-slate-500">No scores yet — trigger "Recompute Now" or wait for the next 5-minute cycle.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<%- include('partials/header') %>
<%- include('partials/json-ld') %>

<%
  const isJob = post.category === 'latest-jobs';
  const catLabels = {
    'latest-jobs': { badge: 'Official Notification Released', doc: 'Notification PDF', docUrl: post.notificationPdf || (post.links && post.links[1] ? post.links[1].url : '') },
    'admit-card': { badge: 'Admit Card Released', doc: 'Download Admit Card', docUrl: post.applyUrl || '' },
    'results': { badge: 'Result Declared', doc: 'Download Result PDF', docUrl: post.notificationPdf || '' },
    'answer-key': { badge: 'Answer Key Released', doc: 'Download Answer Key PDF', docUrl: post.notificationPdf || '' },
    'syllabus': { badge: 'Syllabus Available', doc: 'Download Syllabus PDF', docUrl: post.syllabusPdf || '' }
  };
  const meta = catLabels[post.category] || catLabels['latest-jobs'];
%>

<main class="max-w-4xl mx-auto px-4 py-6 flex-1 w-full pb-24">

  <!-- Breadcrumb -->
  <nav class="flex items-center gap-2 text-[11px] font-medium text-slate-400 mb-4">
    <a href="/" aria-label="Back to Homepage" class="hover:text-white transition">Home</a>
    <span>/</span>
    <a href="/<%= post.category %>" class="capitalize text-brand-accent hover:text-indigo-300 transition">
      <%= post.category.replace('-', ' ') %>
    </a>
    <span>/</span>
    <span class="text-slate-300 truncate max-w-[220px]"><%= post.organization %></span>
  </nav>

  <!-- HEADER: NAME OF POST & STATUS -->
  <div class="bg-brand-card border border-brand-border rounded-2xl p-6 shadow-xl mb-5">

    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-brand-cyan/10 border border-brand-cyan/25 text-brand-cyan text-xs font-bold uppercase tracking-wider mb-3">
      <span>🏛️</span>
      <span><%= post.organization %></span>
    </div>
  <!-- ONE-CLICK VIRAL SHARE ENGINE (WhatsApp / Telegram / Native) -->
  <%
    const postFullUrl = (typeof siteUrl !== 'undefined' && siteUrl ? siteUrl.replace(/\/$/, '') : '') + '/' + post.category + '/' + post.slug;
    const shareMessage = '📢 *' + post.title + '*\n🏛️ *विभाग/Board:* ' + (post.organization || 'Govt of India') + (isJob && post.totalPosts ? '\n👥 *कुल पद:* ' + post.totalPosts : '') + (post.applicationEnd ? '\n⏳ *अंतिम तिथि:* ' + post.applicationEnd : '') + '\n\n🔗 *ऑनलाइन आवेदन और पूरी जानकारी यहाँ देखें:*\n' + postFullUrl + '\n\n📲 *अपने सभी दोस्तों और स्टडी ग्रुप्स में शेयर करें!*';
    const waLink = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(shareMessage);
    const tgLink = 'https://t.me/share/url?url=' + encodeURIComponent(postFullUrl) + '&text=' + encodeURIComponent('📢 ' + post.title + ' | ' + (post.organization || ''));
  %>

  <div class="bg-gradient-to-r from-emerald-950/40 via-[#0F172A] to-cyan-950/40 border border-emerald-500/30 rounded-xl p-3 mb-5 shadow-lg">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5">
      <div class="flex items-center gap-2">
        <span class="text-lg">📢</span>
        <div>
          <span class="text-xs font-bold text-slate-200 block leading-tight">दोस्तो के साथ शेयर करें (Help Your Friends)</span>
          <span class="text-[10px] text-slate-400">1-क्लिक में WhatsApp ग्रुप्स या Telegram पर भेजें</span>
        </div>
      </div>

      <div class="flex items-center gap-1.5 w-full sm:w-auto">
        <!-- WhatsApp Share Button -->
        <a href="<%= waLink %>" aria-label="Share on WhatsApp" target="_blank" rel="noopener noreferrer"
           class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#25D366]/20 hover:bg-[#25D366]/30 text-[#25D366] border border-[#25D366]/40 text-xs font-bold transition shadow-sm">
          <span>💬</span>
          <span>WhatsApp</span>
        </a>

        <!-- Telegram Share Button -->
        <a href="<%= tgLink %>" aria-label="Share on Telegram" target="_blank" rel="noopener noreferrer"
           class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#229ED9]/20 hover:bg-[#229ED9]/30 text-[#229ED9] border border-[#229ED9]/40 text-xs font-bold transition shadow-sm">
          <span>✈️</span>
          <span>Telegram</span>
        </a>

        <!-- Copy Link Button -->
        <button type="button" onclick="copyPostUrl()"
                class="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 text-xs font-semibold transition"
                title="Copy Link">
          🔗
        </button>
      </div>
    </div>
  </div>


    <div class="mb-4">
      <span class="text-xs font-mono text-brand-accent uppercase tracking-wider font-bold block mb-1">
        <%= isJob ? 'Name of Post / पद का नाम:' : 'Title:' %>
      </span>
      <h1 class="text-xl md:text-2xl font-extrabold text-white tracking-tight leading-snug">
        <%= post.title %>
      </h1>
<!-- PROMINENT TOP VACANCY HIGHLIGHT BADGE -->
    <% if (isJob && (post.totalPosts || post.total_posts)) { %>
      <div class="mt-3 inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-brand-accent/20 via-brand-cyan/15 to-transparent border border-brand-accent/40 shadow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-cyan opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-cyan"></span>
        </span>
        <span class="text-xs font-bold text-slate-300 uppercase tracking-wide">Total Vacancies / कुल पद:</span>
        <span class="text-sm md:text-base font-extrabold text-brand-cyan font-mono"><%= post.totalPosts || post.total_posts %> Posts</span>
      </div>
    <% } %>
    </div>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 py-3 border-y border-brand-border/60 text-xs text-slate-400">
      <div>
        <span class="text-slate-400">Posted / Updated:</span>
        <strong class="text-slate-200 ml-1 font-mono">
          <% const d = post.postedDate || post.updatedAt || post.createdAt; %><%= (d && !isNaN(new Date(d).getTime()) && new Date(d).getFullYear() > 1970) ? new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" }) : new Date().toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" }) %>
        </strong>
      </div>
      <div class="text-brand-emerald flex items-center gap-1.5 font-semibold">
        <span class="w-2 h-2 rounded-full bg-brand-emerald animate-pulse"></span>
        <span><%= meta.badge %></span>
      </div>
    </div>

    <!-- Description — the primary (often only) content for non-job categories -->
    <div class="mt-4 text-xs text-slate-300 leading-relaxed space-y-1">
      <strong class="text-white block font-bold text-[13px]">
        <%= isJob ? 'Short Information (संक्षिप्त विवरण):' : 'Description:' %>
      </strong>
      <p class="text-slate-300">
        <% if (post.description && post.description.trim()) { %>
          <%= post.description %>
        <% } else if (isJob) { %>
          <%= post.organization %> has released the official recruitment notification for <%= post.title %>. Interested female/male candidates who fulfill the eligibility criteria can read the complete notification and apply online before the last date.
        <% } else { %>
          <%= post.organization %> has released <%= post.title %>. Check the official link below for full details.
        <% } %>
      </p>
    </div>
  </div>

  <%- include('partials/advisory') %>
  <%- include('partials/ad-slot', { slotType: 'top' }) %>

  <% if (isJob) { %>
    <!-- ======================================================= -->
    <!-- FULL RECRUITMENT LAYOUT — jobs only -->
    <!-- ======================================================= -->

        <!-- STANDALONE TOTAL POSTS SECTION (Header Highlight) -->
    <% if (post.totalPosts || post.total_posts) { %>
      <div class="mb-5 bg-[#111A2E] border border-brand-border rounded-2xl p-4 flex items-center justify-between shadow-lg">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-cyan/15 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan text-lg">
            ⚡
          </div>
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-white block">Total Vacancies / कुल पद</span>
            <span class="text-[11px] text-slate-400">Total number of notified vacancies for this recruitment</span>
          </div>
        </div>
        <div class="text-right">
          <div class="inline-flex items-baseline gap-1.5 bg-brand-card px-3.5 py-1.5 rounded-xl border border-brand-cyan/30">
            <span class="text-lg md:text-xl font-black text-brand-cyan font-mono"><%= post.totalPosts || post.total_posts %></span>
            <span class="text-xs font-bold text-slate-400">Posts</span>
          </div>
        </div>
      </div>
    <% } %>

    <!-- IMPORTANT DATES & FEE -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
      <div class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between">
        <div class="bg-[#111A2E] border-b border-brand-border px-4 py-3">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-cyan flex items-center gap-2"><span>📅</span> Important Dates / महत्वपूर्ण तिथियां</h2>
        </div>
        
        
        <div class="p-4 space-y-3 text-xs">
          <% if (post.importantDates && post.importantDates.length > 0) { %>
            <% post.importantDates.forEach(d => { %>
              <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
                <span class="text-slate-300">• <%= d.label %>:</span>
                <strong class="<%= (d.label && (d.label.toLowerCase().includes('last') || d.label.includes('अंतिम'))) ? 'text-brand-rose font-bold font-mono text-sm' : 'text-white font-medium font-mono' %>"><%= d.value %></strong>
              </div>
            <% }) %>
          <% } else { %>
            <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
              <span class="text-slate-300">• Application Begin:</span>
              <strong class="text-white font-medium"><%= post.applicationStart || 'Available Now' %></strong>
            </div>
            <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
              <span class="text-brand-rose font-semibold">• Eligibility / शैक्षणिक योग्यता for Apply:</span>
              <strong class="text-brand-rose font-mono font-bold text-sm"><%= post.applicationEnd %></strong>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-300">• Exam Date / Merit List:</span>
              <strong class="text-brand-amber font-medium">As per Schedule</strong>
            </div>
          <% } %>
        </div>

        <div class="p-3 bg-white/[0.02] border-t border-brand-border/40 text-[11px] text-slate-400">
          📌 Apply well before the closing hours to avoid server rush.
        </div>
      </div>

      <div class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between">
        <div class="bg-[#111A2E] border-b border-brand-border px-4 py-3">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-emerald flex items-center gap-2"><span>💳</span> Application Fee / आवेदन शुल्क</h2>
        </div>
        <div class="p-4 space-y-3 text-xs">
          <% if (post.feeStructure && post.feeStructure.length > 0) { %>
            <% post.feeStructure.forEach(f => { %>
              <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
                <span class="text-slate-300">• <%= f.label %>:</span>
                <strong class="text-brand-emerald font-mono font-bold"><%= f.amount %></strong>
              </div>
            <% }) %>
          <% } else { %>
            <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
              <span class="text-slate-300">• General / OBC / EWS:</span>
              <strong class="text-white font-mono"><%= post.feeGeneral || '₹0/-' %></strong>
            </div>
            <div class="flex items-center justify-between border-b border-brand-border/50 pb-2">
              <span class="text-slate-300">• SC / ST / All Female:</span>
              <strong class="text-brand-emerald font-mono font-bold"><%= post.feeSCST || '₹0/-' %></strong>
            </div>
          <% } %>
        </div>
        <div class="p-3 bg-white/[0.02] border-t border-brand-border/40 text-[11px] text-slate-400">
          💳 Mode: Online Net Banking / Debit Card / UPI (If applicable).
        </div>
      </div>
    </div>

    <!-- AGE LIMIT -->
    <div class="bg-brand-card border border-brand-border rounded-2xl p-5 shadow-lg mb-5">
      <div class="border-b border-brand-border pb-2.5 mb-3 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-brand-amber flex items-center gap-2"><span>⏳</span> Age Limit Details / निर्धारित आयु सीमा</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <%
  let minAge = "18 Years";
  let maxAge = post.ageLimit || "35 - 40 Years";
  if (post.ageLimit) {
    const nums = post.ageLimit.match(/\d+/g);
    if (nums && nums.length >= 2) {
      minAge = nums[0] + " Years";
      maxAge = nums[1] + " Years";
    } else if (nums && nums.length === 1) {
      maxAge = nums[0] + " Years";
    }
  }
%>
        <div class="p-3 rounded-xl bg-white/[0.02] border border-brand-border">
          <span class="text-slate-400 block text-[11px]">• Minimum Age (न्यूनतम):</span>
          <strong class="text-white text-sm font-mono mt-0.5 block"><%= minAge %></strong>
        </div>
        <div class="p-3 rounded-xl bg-white/[0.02] border border-brand-border">
          <span class="text-slate-400 block text-[11px]">• Maximum Age (अधिकतम):</span>
          <strong class="text-white text-sm font-mono mt-0.5 block"><%= maxAge %></strong>
        </div>
        <div class="p-3 rounded-xl bg-white/[0.02] border border-brand-border">
          <span class="text-slate-400 block text-[11px]">• Age Relaxation:</span>
          <strong class="text-brand-cyan text-xs mt-0.5 block">Extra as per Rules</strong>
        </div>
      </div>
    </div>

    <!-- VACANCY & ELIGIBILITY -->
    <div class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden shadow-lg mb-5">
      <div class="bg-[#111A2E] border-b border-brand-border px-4 py-3 flex items-center justify-between">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-white">Vacancy Details / कुल रिक्तियां व शैक्षणिक योग्यता</h2>
        <span class="text-xs font-mono font-bold text-brand-cyan">Total Posts: <%= post.totalPosts %></span>
      </div>
      <div class="p-4 overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="bg-white/[0.02] text-slate-300 border-b border-brand-border">
            <tr><th class="p-3 w-1/3">Post Name / पद</th><th class="p-3 w-2/3">Eligibility Criteria / पात्रता विवरण</th></tr>
          </thead>
          <tbody class="divide-y divide-brand-border/50 text-slate-300">
            <tr>
              <td class="p-3 font-bold text-white align-top"><%= post.title.split('Recruitment')[0] || post.title %></td>
              <td class="p-3 leading-relaxed text-slate-200"><%= post.qualifications %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- DISTRICT-WISE VACANCY TABLE -->
    <% if (post.vacancies && post.vacancies.length > 0) { %>
    <div class="bg-brand-card border border-brand-border rounded-2xl p-5 shadow-xl mb-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 border-b border-brand-border pb-3">
        <div>
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-brand-cyan"><%= post.vacancyTitle || "District-Wise Vacancy Details (जनपदवार रिक्तियां)" %></h2>
          <span class="text-[10px] text-slate-400">Total <%= post.vacancies.length %> districts / posts active</span>
        </div>
        <div class="relative max-w-xs w-full">
          <input type="text" id="districtFilterInput" onkeyup="filterDistrictTable()" placeholder="Filter District (e.g. Gonda, Banda)..."
                 class="w-full bg-[#161F30] border border-brand-border rounded-xl px-3 py-1.5 pl-8 text-xs text-white placeholder-slate-400 focus:outline-none focus:border-brand-cyan font-medium"/>
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>
      <div class="overflow-x-auto rounded-xl border border-brand-border">
        <table class="w-full text-left text-xs border-collapse" id="districtTable">
          <thead class="bg-[#111A2E] text-slate-200 border-b border-brand-border font-semibold">
            <tr><th class="p-3">District / Post Name</th><th class="p-3">Total Vacancy</th><th class="p-3">Last Date</th><th class="p-3 text-right">Online Apply Link</th></tr>
          </thead>
          <tbody class="divide-y divide-brand-border/60 text-slate-300">
            <% post.vacancies.forEach(v => { %>
              <tr class="district-row hover:bg-white/[0.02] transition">
                <td class="p-3 font-semibold text-white"><%= v.post %></td>
                <td class="p-3 font-mono text-brand-cyan font-bold"><%= v.seats %></td>
                <td class="p-3 font-mono text-brand-rose"><%= v.lastDate || post.applicationEnd %></td>
                <td class="p-3 text-right">
                  <a href="<%= post.applyUrl || '#' %>" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded bg-brand-accent/15 text-brand-accent hover:bg-brand-accent hover:text-white border border-brand-accent/30 font-bold transition">Apply Online ↗</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <%- include('partials/ad-slot', { slotType: 'content' }) %>

    <!-- HOW TO FILL -->
    <div class="bg-brand-card border border-brand-border rounded-2xl p-5 shadow-lg mb-5">
      <div class="border-b border-brand-border pb-2.5 mb-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-white flex items-center gap-2"><span>📝</span> How to Fill Online Form / आवेदन कैसे भरें</h2>
      </div>
      <ul class="space-y-2 text-xs text-slate-300 list-disc list-inside leading-relaxed">
        <li>Candidates can apply online between the specified opening date and closing date.</li>
        <li>Candidate must read the official notification brochure carefully before proceeding to apply.</li>
        <li>Kindly check and verify all required documents: Eligibility, ID Proof, Address details, and Basic info.</li>
        <li>Keep scanned copies of required documents ready: Photograph, Signature, Domicile & Educational marksheets.</li>
        <li>Before final submission, preview the application form columns carefully and cross-check personal details.</li>
        <li>Pay the application fee (if applicable) and take a clean printout of the finalized application form for future reference.</li>
      </ul>
    </div>

    <!-- USEFUL LINKS -->
    <div class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden shadow-xl mb-6">
      <div class="bg-[#111A2E] border-b border-brand-border px-4 py-3">
        <h2 class="text-xs font-extrabold uppercase tracking-wider text-white flex items-center gap-2"><span>🔗</span> Some Useful Important Links / महत्वपूर्ण आधिकारिक लिंक्स</h2>
      </div>
      <div class="divide-y divide-brand-border/60 text-xs">
        <% 
          const applyTarget = post.applyUrl && post.applyUrl.trim() ? post.applyUrl.trim() : null;
          const notifTarget = post.notificationPdf && post.notificationPdf.trim() ? post.notificationPdf.trim() : (meta.docUrl || null);
          const websiteObj = (post.links && post.links.find(l => {
            const name = (l.name || l.title || '').toLowerCase();
            return name.includes('website') || name.includes('portal') || name.includes('official');
          }));
          const portalTarget = websiteObj ? websiteObj.url : null;
        %>

        <!-- 1. Apply Online -->
        <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02] transition">
          <span class="font-bold text-white">Apply Online (ऑनलाइन आवेदन)</span>
          <% if (applyTarget) { %>
            <a href="<%= applyTarget %>" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-lg bg-brand-accent hover:bg-indigo-500 text-white font-bold transition shadow-md shadow-brand-accent/20">Registration / Login ↗</a>
          <% } else { %>
            <span class="px-4 py-1.5 rounded-lg bg-slate-800/60 text-slate-400 border border-white/5 font-medium">Link Available Soon</span>
          <% } %>
        </div>

        <!-- 2. Notification PDF -->
        <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02] transition">
          <span class="font-bold text-slate-200">Download Notification (मूल विज्ञापन पीडीएफ)</span>
          <% if (notifTarget) { %>
            <a href="<%= notifTarget %>" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-lg bg-brand-cyan/15 hover:bg-brand-cyan/25 text-brand-cyan border border-brand-cyan/30 font-bold transition">Download PDF ↓</a>
          <% } else { %>
            <span class="px-4 py-1.5 rounded-lg bg-slate-800/60 text-slate-400 border border-white/5 font-medium">Link Available Soon</span>
          <% } %>
        </div>

        <% if (post.syllabusPdf) { %>
        <!-- 3. Syllabus PDF -->
        <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02] transition">
          <span class="font-bold text-slate-200">Download Syllabus & Pattern (विस्तृत पाठ्यक्रम)</span>
          <a href="<%= post.syllabusPdf %>" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-lg bg-brand-emerald/15 hover:bg-brand-emerald/25 text-brand-emerald border border-brand-emerald/30 font-bold transition">Download Syllabus PDF ↓</a>
        </div>
        <% } %>

        <!-- 4. Official Website Portal -->
        <div class="p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-white/[0.02] transition">
          <span class="font-bold text-slate-200">Official Website (विभागीय आधिकारिक पोर्टल)</span>
          <% if (portalTarget) { %>

# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=3000

# Your actual registered live domain (without trailing slash)
SITE_URL=https://yourdomain.com
APP_URL=https://yourdomain.com

# Database path on live server
DATABASE_PATH=database/navbharat.sqlite3

# Secret strings (Generate long random strings for live production)
ADMIN_SECRET_SLUG=portal-control-hub-9283
COOKIE_SECRET=change-this-to-a-very-long-random-string-in-production
SESSION_SECRET=change-this-to-another-secure-secret-key-32chars

# Crawler & DB Performance
CRAWLER_INTERVAL_HOURS=2
DB_BUSY_TIMEOUT=5000
